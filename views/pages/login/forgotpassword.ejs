<%- contentFor('body') %>
  <div ng-controller="contaCtrl" class="page-wrapper" ng-cloak>

    <!-- Auth container starts -->
    <div class="auth-container">

      <div class="d-flex justify-content-center">

        <!-- Form starts -->
        <form>

          <!-- Logo starts -->
          <a href="index.html" class="auth-logo mt-5 mb-3">
            <img src="assets/images/logo.fw.png" alt="Wrapmarket" />
          </a>
          <!-- Logo ends -->

          <!-- Authbox starts -->
          <div class="auth-box">

            <h4 class="mb-4">Esqueceu a senha?</h4>
            <h6 class="fw-light mb-4">
              Para acessar seu painel de controle, insira o endereço de e-mail que você forneceu
              durante o processo de registro.
            </h6>

            <div class="mb-3">
              <label class="form-label" for="email">Email <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-envelope"></i>
                </span>
                <input ng-model="_regConta.email" type="email" id="email" class="form-control"
                  placeholder="Principal email">
              </div>
            </div>

            <div class="d-grid gap-2">

              <button ng-click="onEsqueciSenha()" ng-disabled="_await" class="btn btn-primary">
                <span ng-show='_await' class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span ng-show='_await'>Enviando...</span>
                <span ng-show='!_await'>Enviar</span>
              </button>



              <a href="/" class="btn btn-outline-secondary">Lembrou? Clique aqui</a>
            </div>

          </div>
          <!-- Authbox ends -->

        </form>
        <!-- Form ends -->

      </div>

    </div>
    <!-- Auth container ends -->

  </div>