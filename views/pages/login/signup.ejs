<%- contentFor('body') %>
  <div ng-controller="contaCtrl" ng-cloak class="page-wrapper">

    <!-- Auth container starts -->
    <div class="auth-container">

      <div class="d-flex justify-content-center">

        <!-- Form starts -->
        <form>

          <!-- Logo starts -->
          <a href="index.html" class="auth-logo mt-5 mb-3">
            <img src="assets/images/logo.fw.png" alt="Wrapmarket" />
          </a>
          <!-- Logo ends -->

          <!-- Authbox starts -->
          <div class="auth-box">

            <h4 class="mb-4">Inscrever-se</h4>

            <div class="mb-3">
              <label class="form-label" for="name">Nome da Organização <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-person"></i>
                </span>
                <input ng-model="_regConta.nome" type="text" id="name" class="form-control"
                  placeholder="Informe o nome da empresa">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="name">Seu Nome <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-person"></i>
                </span>
                <input ng-model="_regColaborador.nome" type="text" id="name" class="form-control">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="email">Email <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-envelope"></i>
                </span>
                <input ng-model="_regConta.email" type="email" id="email" class="form-control"
                  placeholder="Principal email">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="password">Senha <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-lock"></i>
                </span>
                <input ng-model="_regConta.senha" type="password" id="password" class="form-control"
                  placeholder="Senha">
                <button class="btn btn-outline-secondary" type="button">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <div class="form-text">
                Sua senha deve ter de 8 a 20 caracteres.
              </div>
            </div>


            <div class="d-grid gap-2">

              <button ng-click="onCadastrar()" ng-disabled="_await" class="btn btn-primary">
                <span ng-show='_await' class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span ng-show='_await'>Registrando...</span>
                <span ng-show='!_await'>Cadastrar</span>
              </button>

              <a href="/" class="btn btn-outline-secondary">Lembrou, que tem uma conta? Login</a>
            </div>

          </div>
          <!-- Authbox ends -->

        </form>
        <!-- Form ends -->

      </div>

    </div>
    <!-- Auth container ends -->

  </div>