                        <input ng-model="_regConta.alerta_email_criterio_critico" type="checkbox" class="btn-check"
                          id="alerta_email_criterio_critico" autocomplete="off">
                        <label class="btn btn-outline-danger" for="alerta_email_criterio_critico">Crítico</label>
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 mb-2 bg-success bg-opacity-10 text-success p-2 rounded-2">
                    Envio de WhatsApp
                  </div>

                  <div class="row gx-3 mb-3">
                    <div class="col-sm-2">
                      <label for="displayName" class="form-label">
                        Celular
                      </label>
                      <input ng-model="_regConta.alerta_celular" type="text" class="form-control">
                    </div>
                    <div class="col-sm-3">
                      <label for="displayName" class="form-label">
                        Notificar
                      </label><br>
                      <div class="btn-group" role="group" aria-label="Basic checkbox toggle button group">
                        <input ng-model="_regConta.alerta_celular_criterio_leve" type="checkbox" class="btn-check"
                          id="alerta_celular_criterio_leve" autocomplete="off">
                        <label class="btn btn-outline-danger" for="alerta_celular_criterio_leve">Leve</label>

                        <input ng-model="_regConta.alerta_celular_criterio_importante" type="checkbox" class="btn-check"
                          id="alerta_celular_criterio_importante" autocomplete="off">
                        <label class="btn btn-outline-danger"
                          for="alerta_celular_criterio_importante">Importante</label>

                        <input ng-model="_regConta.alerta_celular_criterio_critico" type="checkbox" class="btn-check"
                          id="alerta_celular_criterio_critico" autocomplete="off">
                        <label class="btn btn-outline-danger" for="alerta_celular_criterio_critico">Crítico</label>
                      </div>
                    </div>
                  </div>

                </div>


                <div class="tab-pane fade" id="pills-e" role="tabpanel" aria-labelledby="pills-e-tab" tabindex="0">

                  <div class="col-12">
                        <div class="d-flex justify-content-start gap-1 mb-3">
                          <button  ng-disabled="_regColaborador" ng-click="onEditarColaborador(undefined)" type="button" class="btn btn-outline-warning">
                            Novo Colaborador
                          </button>
                        </div>
                      </div>

                  <div class="row gx-3 mb-6">
                    <div class="col-sm-7">
                      <div class="invoice-table-container">
                        <div class="table-outer">
                          <div class="table-responsive">
                            <table class="table table-hover align-middle mb-1">
                              <thead>
                                <tr>
                                  <th scope="col" class="w-20">iDTag #</th>
                                  <th scope="col" class="w-60">Nome</th>
                                  <th scope="col" class="w-20">Perfil</th>
                                  <th scope="col">Ações</th>
                                </tr>
                              </thead>
                              <tbody>
                                <tr ng-repeat="item in _listColaboradores">
                                  <td><a class="text-primary fw-semibold">
                                      {{ item.tag }}
                                    </a></td>
                                  <td>
                                    <div class="d-flex align-items-center">
                                      <img src="{{ item._foto }}" class="rounded-circle me-2" width="32" alt="Client">
                                      <span class="text-white">
                                        {{ item.nome }}
                                        <br> <span class="text-light">{{ formatarCargo(item.funcao) }} </span> 
                                      </span>
                                      
                                    </div>
                                  </td>
                                  <td>
                                    {{ item.perfil == 'admin' ? 'Administrador' : 'Colaborador' }}
                                  </td>
                                  <td>
                                    <div class="d-flex gap-1">
                                      <button ng-click="onEditarColaborador(item)" type="button"
                                        class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip"
                                        title="Edit user">
                                        <i class="bi bi-pencil"></i>
                                      </button>
                                      <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="tooltip" title="Delete user">
                                        <i class="bi bi-trash"></i>
                                      </button>

                                    </div>
                                  </td>
                                </tr>

                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div ng-show="_regColaborador" class="col-sm-5">
                      <div class="bg-dark rounded-2 p-3">

                        <div class="mb-4">
                          <h5 class="text-primary">Colaborador</h5>
                        </div>

                        <div class="d-flex align-items-center flex-column position-relative" style="width: 100%;">
                          <div class="position-relative mb-3">
                            <img src="{{ _regColaborador._foto }}" class="img-6x rounded-circle border"
                              alt="Foto do Usuário" />

                            <!-- Botão para trocar foto -->
                            <button ng-click="onGetFotoColoborador()" type="button"
                              class="btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 shadow"
                              title="Alterar foto">
                              <i class="bi bi-camera-fill"></i>
                            </button>
                          </div>
                        </div>


                        <div class="row gx-3 mb-3">
                          <div class="col-sm-7">
                            <label for="cardNo" class="form-label">Nome</label>
                            <input ng-model="_regColaborador.nome" type="text" class="form-control form-control-sm" ng-class="{'is-invalid': !_regColaborador.nome || _regColaborador.nome.trim() === ''}">
                          </div>
                          <div class="col-sm-3">
                            <label for="cardNo" class="form-label">Apelido</label>
                            <input ng-model="_regColaborador.apelido" type="text" class="form-control form-control-sm">
                          </div>
                          <div class="col-sm-2">
                            <label for="cardNo" class="form-label">Ativo</label>
                            <select ng-model="_regColaborador.ativo" class="form-select form-select-sm">
                              <option value="1">Sim</option>
                              <option value="0">Não</option>
                            </select>
                          </div>
                        </div>

                        <div class="row gx-3 mb-3">
                          <div class="col-sm-3">
                            <label for="cardNo" class="form-label">iD Tag</label>
                            <input ng-model="_regColaborador.tag" type="text" class="form-control form-control-sm">
                          </div>
                          <div class="col-sm-6">
                            <label for="cardNo" class="form-label">e-Mail</label>
                            <input ng-model="_regColaborador.email" type="text" class="form-control form-control-sm">
                          </div>
                          <div class="col-sm-3">
                            <label for="cardNo" class="form-label">Celular</label>
                            <input ng-model="_regColaborador.celular" type="text" class="form-control form-control-sm">
                          </div>
                        </div>

                        <div class="row gx-3 mb-3">
                          <div class="col-sm-3">
                            <label for="cardNo" class="form-label">Perfil</label>
                            <select ng-model="_regColaborador.perfil" class="form-select form-select-sm">
                              <option value="admin">Administrador</option>
                              <option value="colaborador">Colaborador</option>
                            </select>
                          </div>
                          <div class="col-sm-3">
                            <label for="cardNo" class="form-label">Função</label>
                            <select ng-model="_regColaborador.id_funcao" class="form-select form-select-sm" ng-class="{'is-invalid': !_regColaborador.funcao || _regColaborador.funcao.trim() === ''}">
                              <option value="auxiliar_logistica">Auxiliar de Logística</option>
                              <option value="assistente_logistica">Assistente de Logística</option>
                              <option value="analista_logistica">Analista de Logística</option>
                              <option value="coordenador_logistica">Coordenador de Logística</option>
                              <option value="supervisor_armazem">Supervisor de Armazém</option>
                              <option value="gerente_logistica">Gerente de Logística</option>
                              <option value="encarregado_expedicao">Encarregado de Expedição</option>
                              <option value="analista_transporte">Analista de Transporte</option>
                              <option value="planejador_demanda">Planejador de Demanda</option>
                              <option value="gestor_supply_chain">Gestor de Supply Chain</option>
                            </select>
                          </div>
                          <div class="col-sm-6">
                            <label for="cardNo" class="form-label">Observação</label>
                            <input ng-model="_regColaborador.observacao" type="text"
                              class="form-control form-control-sm">
                          </div>
                        </div>

                        <div class="d-flex justify-content-end gap-1">
                          <button ng-click="$ctrl.onCarregaPlantaZonas()" class="btn btn-danger me-2" type="button">
                            Excluir
                          </button>

                          <button ng-click="_regColaborador=undefined" class="btn btn-muted" type="button">
                            Cancelar
                          </button>
                          <button ng-click="onSalvarColaborador()" class="btn btn-info" type="button">
                            Salvar
                          </button>
                        </div>

                      </div>
                    </div>
                  </div>


                </div>
              </div>
              <!-- Tabs ends -->

            </div>
          </div>
        </div>
      </div>
      <!-- Row end -->

    </div>
    <!-- App body ends -->