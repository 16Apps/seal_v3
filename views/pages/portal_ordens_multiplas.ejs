        <div>
          <div class="pom-breadcrumb">
            <a href="/portal_movimentacao">Portal</a>
            <span class="mx-1">›</span>
            <span>Leituras RFID</span>
          </div>
          <h1 class="pom-title">Leituras RFID e Ordens</h1>
          <p class="pom-subtitle">
            Acompanhe em tempo real as leituras do portal e o andamento dos pedidos associados.
          </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">
          <select class="form-select form-select-sm pom-portal-select" ng-model="_ui.portalSel"
            ng-options="p.id as p.label for p in _portais">
          </select>
          <div>
            <div class="pom-datetime">{{ _dataHoraTopo }}</div>
