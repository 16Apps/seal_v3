      </div>
    </div>

    <!-- Header -->
    <div class="app-body">

      <!-- Cabeçalho da página -->
      <div class="portal-page-header d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
          <h4 class="fw-semibold">Conferência Multipla Ordens</h4>
          <p class="text-muted mb-0">Acompanhe em tempo real as leituras do portal e o andamento dos pedidos associados.
          </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <div>
            <div class="pom-datetime">{{ _dataHoraTopo }}</div>
            <div class="pom-live" ng-if="_ui.tempoReal">
              <span class="pom-live-dot"></span> Em tempo real
            </div>
          </div>
        </div>
      </div>

