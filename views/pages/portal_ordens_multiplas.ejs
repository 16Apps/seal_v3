      <!-- KPIs -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3" ng-repeat="kpi in _kpis">
          <div class="card pom-panel pom-kpi" ng-class="kpi.iconClass">
            <div class="card-body d-flex align-items-start gap-3">
              <div class="icon-box">
                <i class="bi" ng-class="kpi.icon"></i>
              </div>
              <div>
                <div class="kpi-val">{{ kpi.valor }}</div>
                <div class="kpi-lbl">{{ kpi.label }}</div>
                <div class="pom-spark" ng-if="kpi.spark"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Duas colunas -->
      <div class="row g-3">
        <!-- Leituras -->
        <div class="col-12 col-xl-7">
          <div class="card pom-panel h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                <div>
                  <h2 class="pom-section-title">Últimas 30 Leituras</h2>
                  <p class="pom-section-sub">Registro das tags lidas no portal selecionado</p>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                  <button type="button" class="pom-btn-pausar"
                    ng-if="!_ui.modoRetorno"
                    ng-disabled="!podeIniciarRetorno()"
                    ng-click="onIniciarRetorno()">
                    <i class="bi bi-arrow-return-left me-1"></i>
                    Registrar Retorno
                  </button>
                  <button type="button" class="pom-btn-retorno-finalizar"
                    ng-if="_ui.modoRetorno"
                    ng-disabled="_ui.finalizandoRetorno || !_retorno.qtd"
                    ng-click="onFinalizarRetorno()">
                    <i class="bi bi-check2-circle me-1"></i>
                    {{ _ui.finalizandoRetorno ? 'Gravando…' : 'Finalizar Retorno' }}
                  </button>
                  <button type="button" class="pom-btn-retorno-cancelar"
                    ng-if="_ui.modoRetorno"
                    ng-disabled="_ui.finalizandoRetorno"
                    ng-click="onCancelarRetorno()">
                    Cancelar
                  </button>
                </div>
              </div>

              <div ng-if="_ui.modoRetorno" class="pom-lote-banner pom-retorno-banner py-2 px-3 mb-3">
                <strong>Modo retorno</strong>
                · {{ _retorno.qtd || 0 }} tag(s) lida(s)
                · concluídos voltam a pendente (só na tela até finalizar)
              </div>

              <div ng-if="!_ui.modoRetorno && _loteAtual && _loteAtual.status === 'aberto'"
                class="pom-lote-banner py-2 px-3 mb-3">
                <strong>Pallet #{{ _loteAtual.seq }}</strong> em leitura
                · {{ _loteAtual.qtdTags }} tags novas
                · fecha após silêncio de tag nova
              </div>

              <div class="table-responsive">
                <table class="table table-borderless pom-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Lote</th>
                      <th>Data / Hora</th>
                      <th>Tag (EPC)</th>
                      <th>Match</th>
                      <th>Tokem</th>
                      <th>Antena</th>
                      <th>RSSI</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr ng-repeat="l in leiturasVisiveis()"
                      ng-class="{ 'pom-leitura-excedente': l.excedente, 'pom-leitura-retorno': l.retorno && !l.excedente }">
                      <td><span class="pom-seq">{{ $index + 1 }}</span></td>
                      <td>
                        <span class="pom-lote-badge" ng-if="!l.retorno">P{{ l.lote_seq || '—' }}</span>
                        <span class="pom-badge-retorno" ng-if="l.retorno">RET</span>
                      </td>
                      <td>{{ formatHoraLeitura(l.data_leitura || l.data_hora || l._recebidoEm) }}</td>
                      <td><span class="pom-epc">{{ l.tag || '—' }}</span></td>
                      <td>
                        <span ng-if="l.excedente" class="pom-match-excedente">Excedente</span>
                        <span ng-if="!l.excedente && l.retorno" class="pom-match-retorno">{{ l.matchLabel || 'Retorno' }}</span>
                        <span ng-if="!l.excedente && !l.retorno && l.matchLabel" class="pom-match-ok">{{ l.matchLabel }}</span>
                        <span ng-if="!l.excedente && !l.retorno && !l.matchLabel">—</span>
                      </td>
                      <td>{{ l.tokem || l.token || '—' }}</td>
                      <td>{{ l.antena != null && l.antena !== '' ? l.antena : '—' }}</td>
                      <td><span class="pom-rssi">{{ l.rssi != null && l.rssi !== '' ? l.rssi : '—' }}</span></td>
                    </tr>
                    <tr ng-if="!leiturasVisiveis().length">
                      <td colspan="8" class="text-muted small py-4 text-center">Aguardando leituras do portal…</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <a href="#" class="pom-link-more" ng-if="_ui.limiteLeituras < 30"
                ng-click="onVerMaisLeituras(); $event.preventDefault();">
                Ver mais leituras <i class="bi bi-chevron-down"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Ordens -->
        <div class="col-12 col-xl-5">
          <div class="card pom-panel h-100">
            <div class="card-body">
              <div class="mb-2">
                <h2 class="pom-section-title">Ordens (Pedidos)</h2>
                <p class="pom-section-sub">Progresso das ordens vinculadas às leituras</p>
              </div>

              <div class="pom-ordem-toolbar">
                <select class="form-select form-select-sm pom-select-ordem" ng-model="_ui.ordenacaoOrdem">
                  <option value="ultimas_lidas">Últimas lidas</option>
                  <option value="mais_pendentes">Mais pendentes</option>
                  <option value="id_doc">Nº pedido</option>
                </select>
                <div class="pom-tabs">
                  <button type="button" class="pom-tab" ng-repeat="tab in _filtrosOrdem"
                    ng-class="[tab.class, { active: _ui.filtroOrdem === tab.id }]" ng-click="onFiltroOrdem(tab.id)">
                    {{ tab.label }} {{ tab.count }}
                  </button>
                </div>
              </div>

              <div class="text-center text-muted py-4"
                ng-if="_carregandoOrdens && (!_ordens || !_ordens.length)">
                <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                <div class="small">Carregando ordens do dia…</div>
              </div>

              <div class="text-center text-muted py-4"
                ng-if="!_carregandoOrdens && (!ordensFiltradas() || !ordensFiltradas().length)">
                <i class="bi bi-inbox d-block fs-4 mb-2"></i>
                Nenhuma ordem com partida hoje para esta conta.
              </div>

              <div class="pom-ordem-wrap" ng-repeat="ord in ordensFiltradas() track by ord._id"
                ng-class="{ 'is-open': ordemEstaAberta(ord), 'is-hit': ord._hitLocal }">

                <div class="pom-ordem-item">
                  <div class="pom-ordem-icon" ng-class="ord.iconClass">
                    <i class="bi bi-cart3"></i>
                  </div>
                  <div class="flex-grow-1 min-w-0">
                    <div class="pom-ordem-id">{{ ord.id_doc }}</div>
                    <div class="pom-ordem-meta">{{ ord.cliente }} · {{ ord.hora }}</div>
                    <div class="pom-ordem-meta-retorno" ng-if="ord.retornou">
                      Retornou {{ ord.retornoHora || '' }}
                    </div>
                  </div>
                  <span class="pom-badge" ng-class="ord.badgeClass">{{ ord.statusLabel }}</span>
                  <span class="pom-badge-retorno" ng-if="ord.retornou" title="Itens com retorno">
                    <i class="bi bi-arrow-return-left"></i> Retornou
                  </span>
                  <div class="pom-progress-wrap d-none d-md-block">
                    <div class="pom-progress-text">
                      <span>{{ ord.lidos }} / {{ ord.total }} itens</span>
                      <span>{{ ord.pct }}%</span>
                    </div>
                    <div class="pom-progress">
                      <div class="pom-progress-bar" ng-class="ord.barClass" ng-style="{ width: ord.pct + '%' }"></div>
                    </div>
                  </div>
                  <button type="button" class="pom-chevron-btn" ng-click="onToggleOrdemExpand(ord, $event)"
                    aria-label="Expandir itens da ordem">
                    <i class="bi pom-chevron"
                      ng-class="ordemEstaAberta(ord) ? 'bi-chevron-up open' : 'bi-chevron-down'"></i>
                  </button>
                </div>

                <div class="pom-ordem-itens" ng-show="ordemEstaAberta(ord)">
                  <div class="pom-item-row" ng-repeat="it in ord.itens">
                    <span class="pom-item-seq">{{ it.seq }}</span>
                    <span class="pom-item-tag" title="{{ it.tag }}">{{ it.tag }}</span>
                    <span class="pom-item-ean" ng-if="it.ean && it.ean !== '—'">{{ it.ean }}</span>
                    <span class="pom-badge-retorno" ng-if="it.retornou" title="Retorno {{ it.retornoHora }}">
                      {{ it.retornoHora || 'RET' }}
                    </span>
                    <span class="pom-item-st" ng-class="it.statusClass">{{ it.statusLabel }}</span>
                  </div>
                  <div class="text-muted small py-2" ng-if="!ord.itens || !ord.itens.length">
                    Nenhum item nesta ordem.
                  </div>
                </div>
              </div>

              <a href="#" class="pom-link-more" ng-click="$event.preventDefault();">
                Ver todas as ordens <i class="bi bi-chevron-down"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>