<%- contentFor('body') %>
<div ng-controller="emulatorCtrl" ng-cloak>

  <div class="app-hero-header d-flex align-items-center flex-wrap gap-2">
    <ol class="breadcrumb d-none d-lg-flex mb-0">
      <li class="breadcrumb-item">
        <i class="bi bi-house lh-1"></i>
        <a class="text-decoration-none">Home</a>
      </li>
      <li class="breadcrumb-item active" aria-current="page">Emulador Coletores e SKU</li>
    </ol>
    <div class="ms-lg-auto d-flex align-items-center gap-2">
      <span class="text-muted small d-none d-md-inline">Monte o cenário, arraste objetos e acompanhe o histórico por caixa.</span>
      <img ng-src="{{ _regConta._logo }}" alt="Logo" class="rounded border bg-white d-none d-sm-block" style="height: 36px; width: auto; max-width: 100px; object-fit: contain;">
    </div>
  </div>

  <div class="app-body pt-0">
    <div class="seal-emulator card border-0 shadow-sm overflow-hidden">
      <div class="seal-emulator-inner">
        <aside class="sidebar">
          <div>
            <h2 class="h5 mb-2">Emulador Seal</h2>
            <p class="small mb-0">Gateways e caixas: selecione, arraste, edite e salve o layout.</p>
          </div>

          <div class="toolbox">
            <div class="section-title">Objetos</div>
            <div class="d-flex gap-2">  
            <button type="button" class="tool-btn gateway h-100" ng-click="onAddGateway()">+ Gateway</button>
            <button type="button" class="tool-btn item h-100" ng-click="onAddItem()">+ SKU</button>
          </div>
          </div>

          <div class="controls">
            <div class="section-title">Ações</div>
            <button type="button" class="action-btn primary" ng-click="onSaveLayout()" style="display: none;">Salvar layout</button>
            <button type="button" class="action-btn" ng-click="onLoadLayout()" style="display: none;">Carregar layout</button>
            <button type="button" class="action-btn" ng-click="onExportLayout()" style="display: none;">Exportar JSON</button>
            <button   type="button" class="action-btn danger" ng-click="onDeleteSelected()">Excluir selecionado</button>
            <button type="button" class="action-btn danger" ng-click="onClearAll()">Limpar tudo</button>
          </div>

          <div class="details" ng-show="emulator.form.objName" >
            <div class="section-title">Propriedades</div>
            <label for="objName">Nome</label>
            <input id="objName" type="text" placeholder="Selecione um objeto" autocomplete="off" ng-model="emulator.form.objName" />

            <label for="objType"  style="display: none;">Tipo</label>
            <input id="objType" type="text" placeholder="-" ng-show="false" ng-model="emulator.form.objType"/>

            <label for="objRange" ng-show="emulator.form.objType=='gateway'" >Alcance do gateway</label>
            <input id="objRange" ng-show="emulator.form.objType=='gateway'" type="number" min="40" step="10" placeholder="Somente gateway" ng-model="emulator.form.objRange" />

            <label for="itemTag" ng-show="emulator.form.objType=='item'">Tag / Código</label>
            <input id="itemTag"  ng-show="emulator.form.objType=='item'"type="text" placeholder="Ex.: CX-0001" autocomplete="off" ng-model="emulator.form.itemTag" />

            <button type="button" class="action-btn bg-info text-white" ng-click="onApplyChanges()">Aplicar alterações</button>
            <button
              type="button"
              class="action-btn bg-success text-white"
              ng-show="emulator.selectedGateway && emulator.form.objType=='gateway'"
              ng-click="onOpenGatewayItemsModal()">
              Registrar
            </button>
            <!-- <div class="hint">
              Dicas:<br>
              • Clique para selecionar<br>
              • Ctrl/Shift + clique para multisseleção<br>
              • Arraste para mover<br>
              • Use o mouse para redimensionar<br>
              • Gateways mostram área de cobertura
            </div> -->
          </div>
        </aside>

        <main class="main">
          <div class="topbar">
            <div class="topbar-left">
              <h1 class="h5 mb-0">Área Planta</h1>
              <span class="small text-muted d-block">Organize os Gateways e mova os SKUs livremente</span>
            </div>

            <div class="legend">
              <span class="legend-badge"><span class="dot" style="background:#2563eb"></span> Gateway</span>
              <span class="legend-badge"><span class="dot" style="background:#f59e0b"></span> Caixa</span>
              <span class="legend-badge"><span class="dot" style="background:#10b981"></span> Seleção</span>
            </div>
          </div>

          <div class="workspace">
            <div id="emulatorKonvaContainer"></div>
            <div class="status">{{ emulator.statusText || 'Nenhum objeto selecionado' }}</div>
          </div>
        </main>

        <aside class="sidebar-right" aria-label="Histórico de movimentação">
          <div class="details">
            <div class="section-title">Histórico de movimentação</div>
            <label for="historyItem">Caixa</label>
            <select id="historyItem"
              ng-model="emulator.historyItemId"
              ng-options="opt.id as opt.label for opt in emulator.historyOptions"
              ng-change="onHistoryItemChange()"></select>
            <div class="history-current-line">
              <strong>Local atual</strong>
              <span>{{ emulator.history.currentText || '—' }}</span>
              <div class="sub">{{ emulator.history.currentSub }}</div>
            </div>
            <div class="section-title" style="margin-top:4px">Totais por local</div>
            <div class="history-place-totals">
              <div class="row" ng-repeat="row in emulator.history.totals track by $index">
                <span>{{ row.label }}</span><em>{{ row.totalText }}</em>
              </div>
            </div>
            <button type="button" class="action-btn" ng-click="onResetHistory()">Zerar histórico da caixa</button>
            <label style="margin-top:10px">Trechos finalizados</label>
            <div class="history-log">
              <div class="entry leave" ng-repeat="entry in emulator.history.logEntries track by $index">
                <time>Fim do trecho: {{ entry.endText }}</time>
                <strong>{{ entry.label }}</strong>: {{ entry.durationText }}
                <span class="sub">{{ entry.periodText }}</span>
              </div>
              <div class="empty" ng-if="!emulator.history.logEntries || emulator.history.logEntries.length === 0">
                {{ emulator.history.emptyText }}
              </div>
            </div>
            <p class="hint" style="margin-top:8px;margin-bottom:0">
              Cada trecho encerra ao mudar de local (Fora ou gateway). Em sobreposição, vale o gateway mais próximo do centro da caixa.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </div>

<div class="modal fade" id="emulatorGatewayPickerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header py-2">
        <h6 class="modal-title mb-0">Selecionar gateway cadastrado</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3">
        <label class="form-label small">Registro</label>
        <select class="form-select"
          ng-model="emulator.gatewayPicker.selectedId"
          ng-options="g._id as (g.tokem || g.descricao || g._id) for g in _listGateways">
        </select>
        <div class="d-flex justify-content-end gap-2 mt-3">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary btn-sm" ng-click="onConfirmAddGateway()">Adicionar</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="emulatorItemPickerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header py-2">
        <h6 class="modal-title mb-0">Selecionar SKU</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-3">
        <label class="form-label small">Pesquisar por parte da tag</label>
        <input type="text" class="form-control mb-2" placeholder="Ex.: CX-00"
          ng-model="emulator.itemPicker.search" autocomplete="off" />

        <div class="gateway-items-list border rounded p-1">
          <button type="button"
            class="btn btn-sm w-100 text-start mb-1"
            ng-repeat="it in (_listItens | filter:{tag: emulator.itemPicker.search}) track by it._id"
            ng-class="emulator.itemPicker.selectedId === it._id ? 'btn-primary' : 'btn-outline-secondary'"
            ng-click="emulator.itemPicker.selectedId = it._id; emulator.itemPicker.categoriaPickId = ''">
            <div class="fw-semibold">{{ (it.id_categoria && it.id_categoria.descricao) || it.descricao || 'Sem Vinculo' }}</div>
            <div class="small opacity-75">{{ it.tag || it._id }}</div>
          </button>
          <div class="small text-muted p-2" ng-if="((_listItens | filter:{tag: emulator.itemPicker.search}).length || 0) === 0">
            Nenhum SKU encontrado para esse filtro.
          </div>
        </div>

        <div class="border rounded p-2 mt-2 bg-secondary" ng-if="itemPickerSelectedSemCategoria() && _listCategorias && _listCategorias.length">
          <div class="small fw-semibold mb-2 text-text">Este SKU não tem um Item vinculado</div>
          <div class="d-flex flex-column gap-2">
            <select class="form-select form-select-sm"
              ng-model="emulator.itemPicker.categoriaPickId"
              ng-options="c._id as c.descricao for c in _listCategorias track by c._id">
              <option value="">Selecione um Item…</option>
            </select>
            <button type="button" class="btn btn-warning btn-sm text-dark"
              ng-click="onVincularCategoriaNoItemPicker()"
              ng-disabled="!emulator.itemPicker.categoriaPickId || itemPickerSelectedSemCategoria()._savingCategoriaPicker">
              {{ itemPickerSelectedSemCategoria()._savingCategoriaPicker ? 'Salvando…' : 'Vincular categoria' }}
            </button>
          </div>
        </div>
        <div class="small text-muted mt-2" ng-if="itemPickerSelectedSemCategoria() && (!_listCategorias || !_listCategorias.length)">
          Não há categorias na conta. Cadastre categorias para vincular a este SKU.
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary btn-sm" ng-click="onConfirmAddItem()">Incluir</button>
        </div>
      </div>
    </div>
  </div>
</div>

  <div class="modal fade" id="emulatorGatewayItemsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered emulator-gw-items-phone-dialog">
      <div class="modal-content emulator-gw-items-phone-modal-content border-0">
        <div class="emulator-gw-phone-chassis">
          <div class="emulator-gw-phone-screen">
            <div class="emulator-gw-phone-pane" ng-show="emulator.phoneModalView === 'tags'">
              <header class="emulator-gw-phone-header">
                <div class="emulator-gw-phone-title-row">
                  <div class="emulator-gw-phone-title">
                    <i class="bi bi-bluetooth" aria-hidden="true"></i>
                    <span>App Emulator</span>
                  </div>
                  <div class="emulator-gw-phone-local" ng-if="emulator.selectedGateway">
                    Local: <span>{{ emulator.selectedGateway.name }}</span>
                  </div>
                </div>
                <div class="emulator-gw-phone-actions">
                  <span class="emulator-gw-pill emulator-gw-pill-scan">No raio</span>
                  <span class="emulator-gw-pill emulator-gw-pill-count">{{ emulator.gatewayItemsInRange.length || 0 }} tags</span>
                  <button type="button" class="emulator-gw-pill emulator-gw-pill-stop" data-bs-dismiss="modal" ng-click="emulator.phoneModalView = 'tags'">Fechar</button>
                </div>
                <div class="emulator-gw-phone-progress" aria-hidden="true">
                  <div class="emulator-gw-phone-progress-bar"></div>
                </div>
                <div class="emulator-gw-phone-sub" ng-if="emulator.selectedGateway">
                  {{ _gatewway.id_nivel_loc1.descricao }}
                  {{ _gatewway.id_nivel_loc2 ? ' - ' + _gatewway.id_nivel_loc2.descricao : '' }}
                  {{ _gatewway.id_nivel_loc3 ? ' - ' + _gatewway.id_nivel_loc3.descricao : '' }}
                  {{ _gatewway.id_nivel_loc4 ? ' - ' + _gatewway.id_nivel_loc4.descricao : '' }}
                </div>
              </header>
              <div class="emulator-gw-phone-list gateway-items-list">
                <article class="emulator-gw-device-card" ng-repeat="it in emulator.gatewayItemsInRange track by (it.id + '-' + it.tag)">
                  <div class="emulator-gw-device-top">
                    <i class="bi bi-cpu-fill emulator-gw-device-icon" aria-hidden="true"></i>
                    <span class="emulator-gw-device-name">{{ it.name }}</span>
                  </div>
                  <div class="emulator-gw-device-mid">
                    <div class="emulator-gw-device-mid-left">
                      <span class="emulator-gw-lbl">ID:</span>
                      <span class="emulator-gw-id-pill">{{ it.tag }}</span>
                      <span class="emulator-gw-lbl">Dist.:</span>
                      <span class="emulator-gw-rssi">{{ it.distanceText }}</span>
                    </div>
                    <span class="emulator-gw-loc-pill" ng-if="emulator.selectedGateway">{{ emulator.selectedGateway.name }}</span>
                  </div>
                  <div class="emulator-gw-cat-strip" ng-if="it.gwItemDbLoading">
                    <span class="emulator-gw-cat-loading"><i class="bi bi-arrow-repeat emulator-gw-spin" aria-hidden="true"></i> Verificando cadastro…</span>
                  </div>
                  <div class="emulator-gw-cat-strip emulator-gw-cat-warn" ng-if="!it.gwItemDbLoading && it.itemMissingInDb">
                    Nenhum item cadastrado com esta tag.
                  </div>
                  <div class="emulator-gw-cat-missing" ng-if="!it.gwItemDbLoading && !it.itemMissingInDb && it.needsCategoria && _listCategorias && _listCategorias.length">
                    <label class="emulator-gw-cat-lbl" for="{{ 'gw-cat-' + it.id }}">Sem categoria — vincular</label>
                    <div class="emulator-gw-cat-row">
                      <select class="emulator-gw-cat-select" id="{{ 'gw-cat-' + it.id }}"
                        ng-model="it.categoriaPickId"
                        ng-options="c._id as c.descricao for c in _listCategorias track by c._id">
                        <option value="">Selecione…</option>
                      </select>
                      <button type="button" class="emulator-gw-cat-btn"
                        ng-click="onVincularCategoriaGatewayItem(it)"
                        ng-disabled="!it.categoriaPickId || it.savingCategoria">
                        {{ it.savingCategoria ? '…' : 'OK' }}
                      </button>
                    </div>
                  </div>
                  <div class="emulator-gw-cat-strip emulator-gw-cat-warn" ng-if="!it.gwItemDbLoading && !it.itemMissingInDb && it.needsCategoria && (!_listCategorias || !_listCategorias.length)">
                    Cadastre categorias na conta para vincular.
                  </div>
                  <div class="emulator-gw-device-bot">
                    <span class="emulator-gw-mini-pill"><i class="bi bi-eye" aria-hidden="true"></i> {{ $index + 1 }}</span>
                    <span class="emulator-gw-mini-pill"><i class="bi bi-geo-alt" aria-hidden="true"></i> {{ it.distanceText }}</span>
                  </div>
                </article>
                <div class="emulator-gw-phone-empty" ng-if="!emulator.gatewayItemsInRange || emulator.gatewayItemsInRange.length === 0">
                  Nenhum SKU dentro do raio.
                </div>
              </div>
              <button type="button" class="emulator-gw-fab" ng-click="onFinalizaPosicao()" aria-label="Escolher local de destino">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
              </button>
            </div>

            <div class="emulator-gw-phone-pane emulator-gw-destino-pane" ng-show="emulator.phoneModalView === 'destino'">
              <header class="emulator-gw-destino-head">
                <div class="emulator-gw-destino-head-top">
                  <div class="emulator-gw-destino-head-title">
                    <i class="bi bi-geo-alt-fill emulator-gw-destino-pin" aria-hidden="true"></i>
                    <span>Destino da Posição</span>
                  </div>
                  <button type="button" class="emulator-gw-destino-close" ng-click="onPhoneDestinoBackToTags()" aria-label="Voltar">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                  </button>
                </div>
                <p class="emulator-gw-destino-sub">Selecionar local…</p>
                <button type="button" class="emulator-gw-destino-crumb"
                  ng-click="onDestinoPhoneCrumbBarClick()"
                  ng-disabled="!emulator.destinoDrill.chain.length"
                  ng-class="{ 'is-muted': !emulator.destinoDrill.chain.length }">
                  <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                  <span>{{ destinoPhoneCrumbDisplay() }}</span>
                </button>
                <p class="emulator-gw-destino-crumb-hint" ng-if="emulator.destinoDrill.chain.length">Toque na barra acima para voltar um nível.</p>
                <button type="button" class="emulator-gw-destino-use-folder"
                  ng-click="onDestinoPhoneUseCurrentFolder()"
                  ng-show="emulator.destinoDrill.chain.length">
                  Usar este nível
                </button>
              </header>
              <input type="search" class="emulator-gw-destino-search" ng-model="emulator.destinoDrill.search"
                placeholder="Buscar…" autocomplete="off" />
              <ul class="emulator-gw-destino-list list-unstyled" role="listbox">
                <li ng-repeat="loc in destinoPhoneListItems() track by loc._id" role="option"
                  class="emulator-gw-destino-row"
                  ng-class="{ 'is-selected': destinoPhoneRowIsSelected(loc) }"
                  ng-click="onDestinoPhoneRowClick(loc)">
                  <i class="bi emulator-gw-destino-row-ico" ng-class="destinoPhoneRowIconClass()" aria-hidden="true"></i>
                  <span class="emulator-gw-destino-row-label">{{ loc.descricao || loc._id }}</span>
                  <i class="bi bi-chevron-right emulator-gw-destino-row-chev" aria-hidden="true"
                    ng-if="destinoPhoneLocHasChildren(loc) && emulator.destinoDrill.chain.length < 3"></i>
                </li>
                <li class="emulator-gw-destino-empty" ng-if="destinoPhoneListItems().length === 0">
                  Nenhum local neste nível.
                </li>
              </ul>
              <button type="button" class="emulator-gw-fab emulator-gw-fab-destino"
                ng-click="onConfirmarDestinoPosicao()"
                ng-disabled="!emulator.destinoPicker || !emulator.destinoPicker.selectedIds[0]"
                aria-label="Salvar posição">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>



<%- contentFor('emulatorStyles') %>
<style>
  .seal-emulator {
    --seal-emulator-h: min(78vh, calc(100dvh - 200px));
    min-height: 420px;
  }
  .seal-emulator-inner {
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: var(--seal-emulator-h);
    max-height: calc(100dvh - 160px);
    min-height: 380px;
    background: #f3f5f7;
    color: #1f2937;
  }
  .seal-emulator-inner * { box-sizing: border-box; }

  .seal-emulator-inner .app {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .seal-emulator-inner .sidebar {
    width: 270px;
    flex-shrink: 0;
    background: #111827;
    color: #fff;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid rgba(255,255,255,.08);
    overflow-y: auto;
    min-height: 0;
  }

  .seal-emulator-inner .sidebar-right {
    width: 280px;
    flex-shrink: 0;
    background: #111827;
    color: #fff;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-left: 1px solid rgba(255,255,255,.08);
    overflow: hidden;
    min-height: 0;
    align-self: stretch;
  }

  .seal-emulator-inner .sidebar-right .details {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .seal-emulator-inner .sidebar-right .history-log {
    flex: 1;
    min-height: 120px;
    max-height: none;
    overflow-y: auto;
  }

  .seal-emulator-inner .sidebar h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .seal-emulator-inner .sidebar p {
    margin: 0;
    color: #cbd5e1;
    font-size: 12px;
    line-height: 1.45;
  }

  .seal-emulator-inner .toolbox,
  .seal-emulator-inner .controls,
  .seal-emulator-inner .details {
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    padding: 12px;
  }

  .seal-emulator-inner .section-title {
    margin: 0 0 8px 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #93c5fd;
  }

  .seal-emulator-inner .tool-btn,
  .seal-emulator-inner .action-btn {
    width: 100%;
    border: 0;
    border-radius: 10px;
    padding: 10px 12px;
    cursor: pointer;
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 8px;
    transition: .2s;
  }

  .seal-emulator-inner .tool-btn:hover,
  .seal-emulator-inner .action-btn:hover { transform: translateY(-1px); }

  .seal-emulator-inner .tool-btn.gateway { background: #2563eb; color: #fff; }
  .seal-emulator-inner .tool-btn.item { background: #f59e0b; color: #111827; }
  .seal-emulator-inner .tool-btn:last-child,
  .seal-emulator-inner .action-btn:last-child { margin-bottom: 0; }

  .seal-emulator-inner .action-btn { background: #e5e7eb; color: #111827; }
  .seal-emulator-inner .action-btn.primary { background: #10b981; color: #fff; }
  .seal-emulator-inner .action-btn.danger { background: #ef4444; color: #fff; }

  .seal-emulator-inner .details label {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    color: #cbd5e1;
  }

  .seal-emulator-inner .details input,
  .seal-emulator-inner .details select {
    width: 100%;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,.15);
    background: rgba(255,255,255,.08);
    color: #fff;
    margin-bottom: 8px;
    outline: none;
    font-size: 13px;
  }

  .seal-emulator-inner .details input::placeholder { color: #94a3b8; }

  .seal-emulator-inner .hint {
    font-size: 11px;
    color: #94a3b8;
    line-height: 1.5;
  }

  .seal-emulator-inner .history-place-totals {
    font-size: 12px;
    line-height: 1.55;
    color: #cbd5e1;
    margin-bottom: 8px;
  }

  .seal-emulator-inner .history-place-totals .row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
