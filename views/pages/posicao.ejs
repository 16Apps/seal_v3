<%- contentFor('body') %>
  <div ng-controller="posicaoCtrl" class="app-container" ng-cloak>

    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">

      <!-- Breadcrumb start -->
      <ol class="breadcrumb d-none d-lg-flex">
        <li class="breadcrumb-item">
          <i class="bi bi-house lh-1"></i>
          <a class="text-decoration-none">Processos</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">
          {{ _tipo == 'conferencia' ? 'Conferências' : 'Inventários' }}
        </li>
        <li class="breadcrumb-item text-info" aria-current="page">
          Total: {{ _ui.modoVisualizacao === 'itens' ? itensExpandidos().length : posicoesFiltradas().length }}
        </li>
      </ol>
      <!-- Breadcrumb end -->

      <!-- Filter start -->
      <div class="ms-auto d-flex flex-row gap-1 align-items-center flex-wrap justify-content-end">
        <div class="btn-group btn-group-sm me-1" role="group" aria-label="Modo de visualização">
          <button type="button" class="btn"
            ng-class="_ui.modoVisualizacao === 'ordens' ? 'btn-primary' : 'btn-outline-secondary'"
            ng-click="onModoVisualizacao('ordens')" title="Ver por ordens">
            <i class="bi bi-list-ul"></i> Ordens
          </button>
          <button type="button" class="btn"
            ng-class="_ui.modoVisualizacao === 'itens' ? 'btn-primary' : 'btn-outline-secondary'"
            ng-click="onModoVisualizacao('itens')" title="Ver itens de cada ordem">
            <i class="bi bi-ui-checks"></i> Itens
          </button>
        </div>
        <div class="search-container d-lg-flex d-none">
          <select ng-model="_pesquisa.status" class="form-control" id="searchStatus">
            <option value="" selected>Todos</option>
            <option value="pendente">Pendente</option>
            <option value="aberta">Abertas (pendente + parcial)</option>
            <option value="parcial">Parcial</option>
            <option value="concluido">Concluído</option>
          </select>
          <i class="bi bi-funnel"></i>
        </div>
        <div class="search-container d-lg-flex d-none">
          <select ng-model="_pesquisa.somenteRetorno" class="form-control" id="searchRetorno"
            title="Filtrar pedidos com itens retornados">
            <option value="">Todos (retorno)</option>
            <option value="1">Com retorno</option>
          </select>
          <i class="bi bi-arrow-return-left"></i>
        </div>
        <div class="search-container d-lg-flex d-none">
          <input ng-model="_pesquisa.data_de" id="_pesquisa.data_de" type="date" class="form-control" id="searchDataDe" placeholder="data_de">
          <i class="bi bi-calendar3"></i>
        </div>
        <div class="search-container d-lg-flex d-none">
          <input ng-model="_pesquisa.data_a" id="_pesquisa.data_a" type="date" class="form-control" id="searchDataA" placeholder="data_a">
          <i class="bi bi-calendar3"></i>
        </div>

        <div class="search-container d-lg-flex d-none">
          <input ng-model="_pesquisa.pesquisa" type="text" class="form-control" id="searchData"
            placeholder="Pedido, descrição ou endereço…"
            title="Busca em idDoc, descrição e níveis de origem/destino">
          <i class="bi bi-search"></i>
        </div>
        <button ng-click="onPosicao('add', undefined)" type="button"
          class="btn btn-warning btn-sm ms-3 text-dark">Novo</button>
        <button ng-click="onExportarCSV()" type="button"
          class="btn btn-success btn-sm ms-2" title="Exportar lista para CSV">
          <i class="bi bi-file-earmark-arrow-down"></i>
        </button>
        <button ng-click="onCarregaRegistros()" type="button"
          class="btn btn-secondary btn-sm ms-2" title="Atualizar lista">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
      </div>
      <!-- Filter end -->

    </div>
    <!-- App Hero header ends -->

    <!-- App body starts -->
    <div class="app-body">

      <div class="modal fade" id="modalPosicao" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
          <posicao funcao="funcaoLoc" edit="editLoc" tipo="_tipo" on-fechar="onPosicao()"></posicao>
        </div>
      </div>

      <div class="row gx-3">
        <div class="col-xxl-12">
          <div class="card mb-3">
            <div class="card-body">
              <div class="table-responsive">
                <div class="table-outer">

                  <!-- Visão por ORDENS (padrão) -->
                  <table class="table align-middle table-hover m-0" ng-if="_ui.modoVisualizacao === 'ordens'">
                    <thead>
                      <tr>

                        <!-- ID Doc -->
                        <th class="w-10"> 
                        </th> 

                        <th class="w-10" class="w-5 sortable" ng-click="sortBy('id_doc')">iD Doc
                          <i class="bi" ng-class="{'bi-caret-up-fill': sortField=='id_doc' && !sortReverse,'bi-caret-down-fill': sortField=='id_doc' && sortReverse}"></i>
                        </th>

                        <th class="w-10" class="w-5 sortable" ng-click="sortBy('descricao')">Inf. Extra
                          <i class="bi" ng-class="{'bi-caret-up-fill': sortField=='descricao' && !sortReverse,'bi-caret-down-fill': sortField=='descricao' && sortReverse}"></i>
                        </th>

                        <!-- Partida -->
                        <th ng-class="_tipo == 'conferencia' ? 'w-30' : 'w-60'" class="sortable" ng-click="sortBy('partida_data')">
                          {{ _tipo == 'conferencia' ? 'Partida' : _regConta.params_nomenclatura_itens.enderecos }}
                          <i class="bi" ng-class="{'bi-caret-up-fill': sortField=='partida' && !sortReverse,'bi-caret-down-fill': sortField=='partida' && sortReverse}"></i>
                        </th>

                        <!-- Chegada -->
                        <th ng-show="_tipo == 'conferencia'" class="w-40 sortable" ng-click="sortBy('_previsao_chegada_data')">
                          Chegada
                          <i class="bi" ng-class="{'bi-caret-up-fill': sortField=='chegada' && !sortReverse,'bi-caret-down-fill': sortField=='chegada' && sortReverse }"></i>
                        </th>

                        <!-- Itens -->
                        <th class="w-20 sortable text-center" ng-click="sortBy('itens')">
                          {{ _regConta.params_nomenclatura_itens.sku }}s
                          <i class="bi" ng-class="{'bi-caret-up-fill': sortField=='itens' && !sortReverse,'bi-caret-down-fill': sortField=='itens' && sortReverse}"></i>
                        </th>

                        <th class="w-10" >Ações</th>

                      </tr>
                    </thead>

                    <tbody>
                      <style>
                        .status-circle {
                          width: 40px;
                          height: 40px;
                          border-radius: 50%;
                          display: inline-block;
                          margin-left: 30px;
                        }

                        .status-concluido {
                          background-color: #28a745;
                        }

                        .status-parcial {
                          background-color: #ffc107;
                        }

                        .status-pendente {
                          background-color: #6c757d;
                        }

                        .badge-retorno-pos {
                          font-size: 0.7rem;
                          font-weight: 700;
                          background: rgba(168, 85, 247, 0.25);
                          color: #c084fc;
                          border: 1px solid rgba(168, 85, 247, 0.4);
                        }
                      </style>
                      <tr ng-repeat="item in posicoesFiltradas() | orderBy:sortField:sortReverse">
                        <td class="align-top">
                    
                          <span ng-class="{
        'status-circle': true,
        'status-concluido': item.status === 'concluido',
        'status-parcial': item.status === 'parcial',
        'status-pendente': item.status === 'aberta' || item.status === 'partida' || item.status === 'pendente'
      }">
                          </span>
                        </td>

                        <td class="align-top">
                          <span class="text-white fw-bold">{{ item.id_doc }}</span>
                          <span class="badge badge-retorno-pos ms-1" ng-if="item._temRetorno"
                            title="{{ item._qtdRetorno }} item(ns) com retorno">
                            <i class="bi bi-arrow-return-left"></i> Retornou
                          </span>
                          <br>
                          <span class="text-muted">{{ formataDataHora(item.createdAt) }}</span>
                          <div class="small text-purple" ng-if="item._temRetorno && item._ultimoRetorno"
                            style="color:#c084fc;">
                            Último retorno: {{ formataDataHora(item._ultimoRetorno) }}
                          </div>
                        </td>

                        <td class="align-top">
                          <span class="text-white fw-bold">{{ item.descricao }}</span>
                        </td>

                        <td class="align-top">
                          <span class="text-white  fw-bold">{{ formataDataHora(item.partida_data) }}</span><br>
                          {{ item.id_nivel_loc1 ? item.id_nivel_loc1.descricao : 'Em Transporte' }}
                          {{ item.id_nivel_loc2 ? ' - ' + item.id_nivel_loc2.descricao : '' }}<br>

                          <span ng-show="item.id_nivel_loc3" class="text-muted">
                            {{ item.id_nivel_loc3 ? item.id_nivel_loc3.descricao : '' }}
                            {{ item.id_nivel_loc4 ? ' - ' + item.id_nivel_loc4.descricao : '' }}
                          </span>
                        </td>

                        <td class="align-top" ng-show="_tipo == 'conferencia'">
                          <span class="fw-bold"
                            ng-class="item._previsao_chegada_data_status ? 'text-success' : 'text-secondary'">
                            {{ formataDataHora(item._previsao_chegada_data) }}
                          </span>
                            <br>
                          {{ item.id_nivel_loc1_destino ? item.id_nivel_loc1_destino.descricao : 'Em Transporte' }}
                          {{ item.id_nivel_loc2_destino ? ' - ' + item.id_nivel_loc2_destino.descricao : '' }}<br>

                          <span ng-show="item.id_nivel_loc3_destino" class="text-muted">
                            {{ item.id_nivel_loc3_destino ? item.id_nivel_loc3_destino.descricao : '' }}
                            {{ item.id_nivel_loc4_destino ? ' - ' + item.id_nivel_loc4_destino.descricao : '' }}
                          </span>
                        </td>

                        <td class="align-top text-center">
                          <span class="text-white fw-bold">{{ item.itens.length }}</span>
                          <div class="d-flex justify-content-center gap-1 mt-1 flex-wrap">
                            <span class="badge bg-success bg-opacity-25 text-success">{{ item._itensConcluido || 0 }}</span>
                            <span class="badge bg-danger bg-opacity-25 text-danger">{{ item._itensPendente || 0 }}</span>
                            <span class="badge badge-retorno-pos" ng-if="item._temRetorno">{{ item._qtdRetorno }} ret.</span>
                          </div>
                        </td>

                        <td class="align-top">
                          <a class="btn btn-info btn-sm" ng-click="onPosicao('edit', item)">
                            <i class="bi bi-pencil"></i>
                          </a>
                        </td>
                      </tr>
                      <tr ng-if="!posicoesFiltradas().length">
                        <td colspan="6" class="text-center text-muted py-4">Nenhum registro encontrado.</td>
                      </tr>
                    </tbody>
                  </table>

                  <!-- Visão por ITENS -->
                  <table class="table align-middle table-hover m-0" ng-if="_ui.modoVisualizacao === 'itens'">
                    <thead>
                      <tr>
                        <th class="sortable" ng-click="sortBy('id_doc')">Pedido</th>
                        <th>Status ordem</th>
                        <th>Partida</th>
                        <th>Tag</th>
                        <th>EAN</th>
                        <th>Status item</th>
                        <th>Leitura</th>
                        <th>Retorno</th>
                        <th class="w-10">Ações</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr ng-repeat="linha in itensExpandidos()">
                        <td>
                          <span class="text-white fw-bold">{{ linha.id_doc }}</span>
                          <span class="badge badge-retorno-pos ms-1" ng-if="linha.temRetorno">
                            <i class="bi bi-arrow-return-left"></i>
                          </span>
                        </td>
                        <td>
                          <span class="badge"
                            ng-class="{
                              'bg-success': linha.ordemStatus === 'concluido',
                              'bg-warning text-dark': linha.ordemStatus === 'parcial',
                              'bg-secondary': linha.ordemStatus === 'pendente' || linha.ordemStatus === 'aberta' || linha.ordemStatus === 'partida'
                            }">{{ linha.ordemStatus }}</span>
                        </td>
                        <td class="small">{{ formataDataHora(linha.partida_data) }}</td>
                        <td><code class="text-info">{{ linha.tag }}</code></td>
                        <td class="small text-muted">{{ linha.ean }}</td>
                        <td>
                          <span ng-class="classeStatusItem(linha.itemStatus)">
                            {{ labelStatusItem(linha.itemStatus) }}
                          </span>
                        </td>
                        <td class="small">
                          <span ng-if="linha.status_data">{{ formataDataHora(linha.status_data) }}</span>
                          <span ng-if="!linha.status_data" class="text-muted">—</span>
                        </td>
                        <td>
                          <span ng-if="linha.temRetorno" style="color:#c084fc;" class="fw-semibold small">
                            {{ formataDataHora(linha.retorno_data) }}
                          </span>
                          <span ng-if="!linha.temRetorno" class="text-muted">—</span>
                        </td>
                        <td>
                          <a class="btn btn-info btn-sm" ng-click="onPosicao('edit', linha.posicao)">
                            <i class="bi bi-pencil"></i>
                          </a>
                        </td>
                      </tr>
                      <tr ng-if="!itensExpandidos().length">
                        <td colspan="9" class="text-center text-muted py-4">Nenhum item encontrado.</td>
                      </tr>
                    </tbody>
                  </table>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
    <!-- App body ends -->