<%- contentFor('body') %>
  <div ng-controller="trackingFluxoCtrl" class="app-container" ng-cloak>

    <div class="app-hero-header d-flex align-items-center">
      <ol class="breadcrumb d-none d-lg-flex">
        <li class="breadcrumb-item">
          <i class="bi bi-house lh-1"></i>
          <a class="text-decoration-none">Processos</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">Fluxos de Tracking</li>
        <li class="breadcrumb-item text-info" aria-current="page">Total: {{ _listFluxos.length }}</li>
      </ol>

      <div class="ms-auto d-flex flex-row gap-1">
        <div class="search-container d-lg-flex d-none">
          <input ng-model="_pesquisa" ng-change="onPesquisa()" type="text" class="form-control" id="searchData"
            placeholder="Pesquisar">
          <i class="bi bi-search"></i>
        </div>
        <button ng-click="onTrackingFluxo('add', undefined)" type="button"
          class="btn btn-warning btn-sm ms-3 text-dark">Novo</button>
      </div>
    </div>

    <div class="app-body">

      <div class="modal fade" id="modalTrackingFluxo" tabindex="-1" aria-labelledby="modalTrackingFluxoLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
          <trackingfluxo funcao="funcaoLoc" edit="editLoc" on-fechar="onTrackingFluxo()"></trackingfluxo>
        </div>
      </div>

      <div class="row gx-3">
        <div class="col-xxl-12">
          <div class="card mb-3">
            <div class="card-body">
              <div class="table-responsive">
                <div class="table-outer">
                  <table class="table align-middle table-hover m-0">
                    <thead>
                      <tr>
                        <th class="sortable" ng-click="sortBy('descricao')">
                          Descrição
                          <i class="bi" ng-class="{
                            'bi-caret-up-fill': sortField=='descricao' && !sortReverse,
                            'bi-caret-down-fill': sortField=='descricao' && sortReverse
                          }"></i>
                        </th>
                        <th class="sortable" ng-click="sortBy('_categoriaDesc')">
                          Categoria
                          <i class="bi" ng-class="{
                            'bi-caret-up-fill': sortField=='_categoriaDesc' && !sortReverse,
                            'bi-caret-down-fill': sortField=='_categoriaDesc' && sortReverse
                          }"></i>
                        </th>
                        <th class="sortable" ng-click="sortBy('_qtdEtapas')">
                          Etapas
                          <i class="bi" ng-class="{
                            'bi-caret-up-fill': sortField=='_qtdEtapas' && !sortReverse,
                            'bi-caret-down-fill': sortField=='_qtdEtapas' && sortReverse
                          }"></i>
                        </th>
                        <th class="sortable" ng-click="sortBy('ativo')">
                          Ativo
                          <i class="bi" ng-class="{
                            'bi-caret-up-fill': sortField=='ativo' && !sortReverse,
                            'bi-caret-down-fill': sortField=='ativo' && sortReverse
                          }"></i>
                        </th>
                        <th>Ações</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr ng-repeat="item in _listFluxos | orderBy:sortField:sortReverse">
                        <td>{{ item.descricao }}</td>
                        <td>{{ item._categoriaDesc }}</td>
                        <td>
                          <span class="badge text-bg-primary">{{ item._qtdEtapas }}</span>
                        </td>
                        <td>
                          <span class="badge" ng-class="item.ativo == 1 || item.ativo == '1' ? 'bg-success' : 'bg-secondary'">
                            {{ item.ativo == 1 || item.ativo == '1' ? 'Sim' : 'Não' }}
                          </span>
                        </td>
                        <td>
                          <a class="btn btn-info btn-sm" ng-click="onTrackingFluxo('edit', item)">
                            <i class="bi bi-pencil"></i>
                          </a>
                        </td>
                      </tr>
                      <tr ng-if="!_listFluxos.length">
                        <td colspan="5" class="text-secondary text-center py-4">
                          Nenhum fluxo cadastrado.
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
