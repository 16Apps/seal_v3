<%- contentFor('body') %>
  <div ng-controller="categoriaCtrl" class="app-container" ng-cloak>

    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">

      <!-- Breadcrumb start -->
      <ol class="breadcrumb d-none d-lg-flex">
        <li class="breadcrumb-item">
          <i class="bi bi-house lh-1"></i>
          <a class="text-decoration-none">Gestão de {{ _regConta.params_nomenclatura_itens.sku }}s</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">{{ _regConta.params_nomenclatura_itens.itens }}s</li>
        <li class="breadcrumb-item text-info" aria-current="page">Total: {{ _listCategorias.length }}</li>
      </ol>
      <!-- Breadcrumb end -->

      <!-- Filter start -->
      <div class="ms-auto d-flex flex-row gap-1 ">
        <div class="search-container d-lg-flex d-none">
          <input ng-model="_pesquisa" ng-change="onPesquisa()" type="text" class="form-control" id="searchData"
            placeholder="Pesquisar">
          <i class="bi bi-search"></i>
        </div>
        <button ng-click="onCategoria('add', undefined)" type="button"
          class="btn btn-warning btn-sm ms-3 text-dark">Novo</button>
        <button ng-click="onExportarCSV()" type="button"
          class="btn btn-success btn-sm ms-2" title="Exportar lista para CSV">
          <i class="bi bi-file-earmark-arrow-down"></i>
        </button>
        <button ng-click="onImportar()" type="button" class="btn btn-info btn-sm ms-3 text-white">
          Importar
        </button>
      </div>
      <!-- Filter end -->

    </div>
    <!-- App Hero header ends -->

    <!-- App body starts -->
    <div class="app-body">

      <div class="modal fade" id="modalCategoria" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
          <categoria funcao="funcaoLoc" edit="editLoc" on-fechar="onCategoria()"></categoria>
        </div>
      </div>


      <div class="row gx-3">
        <div class="col-xxl-12">
          <div class="card mb-3">
            <div class="card-body">
              <div class="table-responsive">
                <div class="table-outer">
                  <table class="table align-middle table-hover m-0">
                    <thead>
                      <tr>

                        <!-- Descrição -->
                        <th>

                        </th>

                        <th class="w-70" class="sortable" ng-click="sortBy('descricao')">
                          Descrição
                          <i class="bi" ng-class="{
            'bi-caret-up-fill': sortField=='descricao' && !sortReverse,
            'bi-caret-down-fill': sortField=='descricao' && sortReverse
         }"></i>
                        </th>

                        <!-- EAN -->
                        <th class="w-10 sortable" ng-click="sortBy('ean')">
                          EAN
                          <i class="bi" ng-class="{
            'bi-caret-up-fill': sortField=='ean' && !sortReverse,
            'bi-caret-down-fill': sortField=='ean' && sortReverse
         }"></i>
                        </th>
                        <th class="w-20">Labels e Valores</th>

                        <th>Ações</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr ng-repeat="item in _listCategorias | orderBy:sortField:sortReverse">
                        <td>
                          <img class="rounded-circle img-3x me-2" src="{{ item._foto }}" alt="Wrapmarket" />
                        </td>
                        <td>{{ item.descricao }}</td>
                        <td>{{ item.ean }}</td>
                        <td>
                          <div ng-if="item.labelInf1">{{ item.labelInf1 }}: {{ item.valor_labelInf1 || '-' }}</div>
                          <div ng-if="item.labelInf2">{{ item.labelInf2 }}: {{ item.valor_labelInf2 || '-' }}</div>
                          <div ng-if="item.labelInf3">{{ item.labelInf3 }}: {{ item.valor_labelInf3 || '-' }}</div>
                          <div ng-if="item.labelInf4">{{ item.labelInf4 }}: {{ item.valor_labelInf4 || '-' }}</div>
                          <div ng-if="item.labelInf5">{{ item.labelInf5 }}: {{ item.valor_labelInf5 || '-' }}</div>
                        </td>
                        <td>
                          <a class="btn btn-info btn-sm" ng-click="onCategoria('edit', item)">
                            <i class="bi bi-pencil"></i>
                          </a>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="offcanvas offcanvas-bottom" tabindex="-1" id="offcanvasImportar"
        aria-labelledby="offcanvasBottomLabel" style="height: 550px !important;">
        <div class="offcanvas-header">
          <h5 class="offcanvas-title" id="offcanvasBottomLabel">Importar</h5>
          <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">

          <div class="ms-auto d-flex flex-row gap-1">
            <div class="search-container d-lg-flex d-none">
              <input type="file" id="fileImport" accept=".csv" class="form-control"
                onchange="angular.element(this).scope().onLerArquivoImportacao(event)">
            </div>

            <button ng-click="onExecutarImportacao()" type="button" class="btn btn-warning btn-sm ms-3 text-dark">
              <i class="bi bi-box-arrow-in-down me-1"></i> Importar
            </button>
          </div>

          <div class="row gx-3">
            <div class="col-xxl-12">
              <div class="card mb-3">
                <div class="card-body">
                  <div class="table-responsive">
                    <div class="table-outer">
                      <table class="table align-middle table-hover m-0">
                        <thead>
                          <tr>
                            <th>Descrição</th>
                            <th class="w-20"></th>
                            <th class="w-40">EAN</th>
                            <th class="w-20">Labels</th>   
                            <th class="w-20">Valores</th>    
                          </tr>
                        </thead>
                        <tbody>
                          <tr ng-repeat="item in _dadosImportacao">
                            <td>
                              <img class="rounded-circle img-3x me-2" src="{{ item._foto }}" alt="Wrapmarket" />
                            </td>
                            <td>{{ item.descricao }}</td>
                            <td>{{ item.ean}}</td>
                            <td>
                              {{ item.labelInf1}}
                              {{ item.labelInf2 ? ' - ' + item.labelInf2 : '' }}
                              {{ item.labelInf3 ? ' - ' + item.labelInf3 : '' }}
                              {{ item.labelInf4 ? ' - ' + item.labelInf4 : '' }}
                              {{ item.labelInf5 ? ' - ' + item.labelInf5 : '' }}
                            </td>
                            <td>
                              {{ item.valor_labelInf1}}
                              {{ item.valor_labelInf2 ? ' - ' + item.valor_labelInf2 : '' }}
                              {{ item.valor_labelInf3 ? ' - ' + item.valor_labelInf3 : '' }}
                              {{ item.valor_labelInf4 ? ' - ' + item.valor_labelInf4 : '' }}
                              {{ item.valor_labelInf5 ? ' - ' + item.valor_labelInf5 : '' }}
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>

    </div>
    <!-- App body ends -->