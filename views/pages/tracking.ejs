          },
        ],
        chart: {
          type: "line",
          height: 40,
          sparkline: {
            enabled: true,
          },
        },
        colors: ["#fe5f55"],
        stroke: {
          curve: "smooth",
          width: 5,
        },
        tooltip: {
          y: {
