          },
        },
        fill: {
          type: "gradient",
          gradient: {
            shade: "dark",
            type: "horizontal",
            shadeIntensity: 0.5,
            gradientToColors: undefined,
            inverseColors: true,
          },
        },
      };

      var chart2 = new ApexCharts(
        document.querySelector("#sparklineLine2"),
        options2
      );
      chart2.render();

      // Sparkline 3
      var options3 = {
        series: [
          {
            name: "Users",
