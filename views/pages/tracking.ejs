<%- contentFor('body') %>
  <div ng-controller="trackingCtrl" class="app-container" ng-cloak>

    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">

      <ol class="breadcrumb d-none d-lg-flex">
        <li class="breadcrumb-item">
          <i class="bi bi-house lh-1"></i>
          <a class="text-decoration-none">Home</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">Tracking</li>

        <li class="breadcrumb-item" aria-current="page">
          <select ng-model="_filtroNivel1" ng-change="onCarregaNiveis('02')" class="form-select bg-info text-white"
            aria-label="Month">
            <option value="">Todos Endereços</option>
            <option ng-repeat="item in _listNivel1 track by $index" value="{{ item._id}}">{{ item.descricao }}</option>
          </select>
        </li>

        <li ng-show="_filtroNivel1" class="breadcrumb-item" aria-current="page">
          <select ng-model="_filtroNivel2" ng-change="onCarregaNiveis('03')"
            class="form-select  bg-info text-white opacity-75" aria-label="Month">
            <option value="">Todos</option>
            <option ng-repeat="item in _listNivel2 track by $index" value="{{ item._id}}">{{ item.descricao }}</option>
          </select>
        </li>

        <li ng-show="_filtroNivel2" class="breadcrumb-item" aria-current="page">
          <select ng-model="_filtroNivel3" ng-change="onCarregaNiveis('04')"
            class="form-select  bg-info text-white opacity-50" aria-label="Month">
            <option value="">Todos</option>
            <option ng-repeat="item in _listNivel3 track by $index" value="{{ item._id}}">{{ item.descricao }}</option>
          </select>
        </li>

        <li ng-show="_filtroNivel3" class="breadcrumb-item" aria-current="page">
          <select ng-model="_filtroNivel4" class="form-select bg-info text-white opacity-25" aria-label="Month">
            <option value="">Todos</option>
            <option ng-repeat="item in _listNivel4 track by $index" value="{{ item._id}}">{{ item.descricao }}</option>
          </select>
        </li>

      </ol>
    </div>

    <div class="app-body">

      <div class="row gx-3">
        <div class="col-xxl-6 col-sm-12 col-12">

          <div class="row gx-3">
            <div class="col-xxl-5 col-sm-6 col-12 p-4">
              <img src="{{ _regConta._logo }}" class="img-fluid" alt="Logo" style="max-height: 130px; border-radius: 10px; border: 1px solid #596071; padding: 5px;">
   
            </div>
          </div>

          <div class="row gx-3 p-4">
            <div class="col-xxl-5 col-sm-6 col-12">
              <div class="card mb-3">
                <div class="card-body ">
                  <div class="d-flex align-items-center justify-content-between ">
                    <div class="icon-box md border border-primary bg-primary bg-opacity-10 rounded-5">
                      <i class="bi bi-box-seam fs-4 text-primary"></i>
                    </div>
                    <div class="text-end">
                      <h3 class="text-primary display-5">{{ _regResumoItens.total }}</h3>
                      <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 small">
                        {{ formataDataHora(_regResumoItens.ultimo_item_cadastrado.createdAt) }}
                      </span>
                    </div>
                  </div>
                  <h6 class="m-0 text-light">{{ _regConta.params_nomenclatura_itens.sku }}s Cadastrados</h6>
                </div>
              </div>
            </div>

            <div class="col-xxl-5 col-sm-6 col-12">
              <div class="card mb-3">
                <div class="card-body">
                  <div class="d-flex align-items-center justify-content-between">
                    <div class="icon-box md border border-warning bg-warning bg-opacity-10 rounded-5">
                      <i class="bi  bi-arrow-left-right fs-4 text-warning"></i>
                    </div>
                    <div class="text-end">
                      <h3 class="text-warning display-5">{{ _listRegistros.total_registros }}</h3>
                      <span ng-show="_listRegistros.length > 0 && _listRegistros[0].locais.length > 0" class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 small">
                      
                        {{ formataDataHora(_listRegistros[0].locais[0].data_registro) }}
                      </span>
                    </div>
                  </div>
                  <h6 class="m-0 text-light">Movimentações</h6>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-xxl-6">
          <!-- Oracle Cloud -->
          <!-- <planta class="w-100" id_nivel_planta="id_nivelPlanta" mostrar-legenda-descricao="false" tamanho-fonte-legenda="80" zoom-inicial="0.4" mostrar-marcacao-area="false">
          </planta> -->

          <!-- Suvinil -->
          <planta class="w-100" id_nivel_planta="id_nivelPlanta" mostrar-legenda-descricao="true" tamanho-fonte-legenda="40" zoom-inicial="0.4" mostrar-marcacao-area="true">
          </planta>

        </div>
      </div>

      <div ng-show="_listRegistros.length > 0" class="col-xxl-12 col-sm-12 col-12 mb-3 mt-4">
        <div class="card mb-0  mt-4">
          <div class="card-header">
            <h5 class="card-title">Deslocamentos Recentes</h5>
          </div>
          <div class="card-body pt-0">

            <div class="row gx-3">
              <div ng-repeat="item in _listRegistros  | limitTo: 4 track by $index  " class="col">
                <div class="card mb-0">
                  <div class="card-header">
                    <div class="d-flex align-items-center gap-2">
                      <img src="{{ item._foto}}" alt="Item"
                        style="width: 58px; height: 58px; object-fit: contain; margin-right: 10px;">
                      <h5 class="card-title mb-0">
                        {{ item.categoria_descricao }}
                        <br>
                        <small class="text-muted">{{ item.tag }}</small>
                      </h5>
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="scroll250">
                      <ul class="list-unstyled d-grid gap-4">
                        <li class="tracking d-grid gap-3 pb-0">

                          <div ng-repeat="local in item.locais  | limitTo: 4 track by $index  " class="tracking-block d-flex gap-3">
                            <div class="tracking-icon  bg-opacity-10"
                              ng-class="local.id_nivel_loc1 ? 'bg-primary' : 'bg-warning'">
                              <i class="bi"
                                ng-class="local.id_nivel_loc1 ? 'bi-geo-alt text-primary lh-1' : 'bi-truck text-warning lh-1'">
                              </i>
                            </div>
                            <div class="tracking-details d-grid gap-2">
                              <h6 class="m-0" >
                                {{ local.id_nivel_loc1 ? local.local1_descricao : 'Em Trânsito '}}
                              </h6>
                              <h6 class="m-0 d-flex align-items-center" ng-class="lcoal.id_nivel_loc1 ? 'text-primary' : 'text-warning'">
                                {{ local.id_nivel_loc2 ? local.local2_descricao : '&nbsp;'}}
                              </h6>
                              <small class="text-muted">
                                <!-- <i class="bi bi-check-circle me-1"></i> -->
                                {{ formataDataHora(local.data_registro) }}         
                              </small>
                              <small ng-show="local._tempo_deslocamento_min" class="text-info"><i class="bi bi-clock me-1"></i>
                                {{ local._tempo_deslocamento_texto  }}         
                              </small>
                            </div>
                          </div>


                        </li>

                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
      <!-- Row end -->






    </div>
    <!-- App body ends -->

    <!-- App footer start -->
    <div class="app-footer">
      <span>© Seal 2026</span>
    </div>
    <!-- App footer end -->

  </div>

  <script>

    document.addEventListener("DOMContentLoaded", function () {
      // Sparkline 1
      var options1 = {
        series: [
          {
            name: "Likes",
            data: [10, 20, 30, 50, 40, 30, 5],
          },
        ],
        chart: {
          type: "line",
          height: 40,
          sparkline: {
            enabled: true,
          },
        },
        colors: ["#04a777"],
        stroke: {
          curve: "smooth",
          width: 5,
        },
        tooltip: {
          y: {
            formatter: function (val) {
              return val;
            },
          },
        },
        fill: {
          type: "gradient",
          gradient: {
            shade: "dark",
            type: "horizontal",
            shadeIntensity: 0.5,
            gradientToColors: undefined,
            inverseColors: true,
          },
        },
      };

      var chart1 = new ApexCharts(
        document.querySelector("#sparklineLine1"),
        options1
      );
      chart1.render();

      // Sparkline 2
      var options2 = {
