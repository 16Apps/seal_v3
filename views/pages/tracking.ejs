          },
        ],
        chart: {
          type: "line",
          height: 40,
          sparkline: {
            enabled: true,
          },
        },
        colors: ["#20a1d0"],
        stroke: {
          curve: "smooth",
          width: 5,
        },
        tooltip: {
          y: {
            formatter: function (val) {
              return val;
            },
          },
        },
        fill: {
          type: "gradient",
          gradient: {
            shade: "dark",
            type: "horizontal",
            shadeIntensity: 0.5,
            gradientToColors: undefined,
            inverseColors: true,
          },
        },
      };

      var chart4 = new ApexCharts(
        document.querySelector("#sparklineLine4"),
        options4
      );
      chart4.render();
    });
  </script>