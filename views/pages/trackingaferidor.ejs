<%- contentFor('body') %>
<style>
  .taf-page { margin-bottom: 2rem; }

  .taf-breadcrumb {
    font-size: 0.78rem;
    color: #94a3b8;
    margin-bottom: 0.35rem;
  }
  .taf-breadcrumb a { color: #94a3b8; text-decoration: none; }
  .taf-breadcrumb a:hover { color: #e2e8f0; }

  .taf-title {
    font-size: 1.55rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
  }
  .taf-subtitle {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0.35rem 0 0;
    max-width: 44rem;
  }
  .taf-datetime { font-size: 0.82rem; color: #cbd5e1; }
  .taf-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #86efac;
  }
  .taf-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    animation: taf-pulse 1.8s infinite;
  }
  .taf-live.is-paused { color: #fde68a; }
  .taf-live.is-paused .taf-live-dot {
    background: #fbbf24;
    animation: none;
  }
  .taf-live.is-idle { color: #94a3b8; }
  .taf-live.is-idle .taf-live-dot {
    background: #64748b;
    animation: none;
  }
  @keyframes taf-pulse {
    0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55); }
    70% { box-shadow: 0 0 0 8px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  .taf-panel {
    background: rgba(30, 41, 59, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 0.75rem;
    color: #e2e8f0;
  }
  .taf-panel .card-body { padding: 1.1rem 1.25rem; }

  .taf-btn {
    border-radius: 0.5rem;
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid transparent;
  }
  .taf-btn-ghost {
    border-color: rgba(148, 163, 184, 0.35);
    background: rgba(15, 23, 42, 0.45);
    color: #cbd5e1;
  }
  .taf-btn-ghost:hover { background: rgba(51, 65, 85, 0.55); color: #f8fafc; }
  .taf-btn-start {
    border-color: rgba(34, 197, 94, 0.45);
    background: rgba(34, 197, 94, 0.18);
    color: #86efac;
  }
  .taf-btn-start:hover { background: rgba(34, 197, 94, 0.28); color: #bbf7d0; }
  .taf-btn-pause {
    border-color: rgba(251, 191, 36, 0.45);
    background: rgba(251, 191, 36, 0.15);
    color: #fde68a;
  }
  .taf-btn-pause:hover { background: rgba(251, 191, 36, 0.25); color: #fef3c7; }
  .taf-btn-stop {
    border-color: rgba(248, 113, 113, 0.45);
    background: rgba(239, 68, 68, 0.18);
    color: #fca5a5;
  }
  .taf-btn-stop:hover { background: rgba(239, 68, 68, 0.28); color: #fecaca; }
  .taf-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .taf-input, .taf-select {
    background: #0f172a !important;
    color: #e2e8f0 !important;
    border-color: rgba(148, 163, 184, 0.25) !important;
  }

  .taf-gw-label { font-size: 0.72rem; color: #94a3b8; margin: 0 0 0.35rem; }
  .taf-gw-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }
  .taf-gw-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(59, 130, 246, 0.35);
    background: rgba(37, 99, 235, 0.18);
    color: #93c5fd;
    cursor: pointer;
  }
  .taf-gw-chip:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(248, 113, 113, 0.45);
    color: #fca5a5;
  }
  .taf-gw-add {
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px dashed rgba(148, 163, 184, 0.4);
    background: rgba(15, 23, 42, 0.45);
    color: #93c5fd;
    font-size: 1.1rem;
  }
  .taf-gw-add:hover {
    border-color: #3b82f6;
    color: #60a5fa;
    background: rgba(37, 99, 235, 0.15);
  }
  .taf-gw-hint { font-size: 0.72rem; color: #64748b; }

  .taf-ref-banner {
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(15, 23, 42, 0.55);
    border-radius: 0.65rem;
    padding: 0.65rem 0.9rem;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .taf-ref-banner strong { color: #cbd5e1; }

  .taf-cards-board {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: stretch;
  }
  .taf-card {
    flex: 1 1 340px;
    min-width: min(100%, 300px);
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.75rem;
    color: #e2e8f0;
    display: flex;
    flex-direction: column;
    cursor: grab;
    transition: border-color 0.15s, box-shadow 0.15s, opacity 0.12s;
  }
  .taf-card:active { cursor: grabbing; }
  .taf-card.is-dragging { opacity: 0.45; }
  .taf-card.is-drag-over {
    border-color: #38bdf8;
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.35);
  }
  .taf-card.is-winner {
    border-color: rgba(34, 197, 94, 0.5);
    box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.25);
  }
  .taf-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem 0.55rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }
  .taf-card-title {
    font-weight: 700;
    font-size: 1rem;
    margin: 0;
    color: #f8fafc;
  }
  .taf-drag-handle { color: #64748b; }
  .taf-card-body {
    padding: 0.75rem 1rem 1rem;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-height: 0;
  }

  .taf-tag-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .taf-tag-tab {
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(30, 41, 59, 0.55);
    color: #94a3b8;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .taf-tag-tab.active {
    background: rgba(37, 99, 235, 0.25);
    border-color: rgba(59, 130, 246, 0.45);
    color: #bfdbfe;
  }

  .taf-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
  }
  .taf-metric {
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(30, 41, 59, 0.45);
    border-radius: 0.55rem;
    padding: 0.5rem 0.55rem;
    text-align: center;
  }
  .taf-metric.is-win {
    border-color: rgba(34, 197, 94, 0.45);
    background: rgba(34, 197, 94, 0.1);
  }
  .taf-metric-lbl {
    font-size: 0.65rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .taf-metric-val {
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
    margin-top: 0.1rem;
  }
  .taf-metrics-block-title {
    font-size: 0.68rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .taf-metrics-block-title .taf-countdown {
    color: #93c5fd;
    font-variant-numeric: tabular-nums;
  }
  .taf-metrics.is-destaque .taf-metric {
    border-color: rgba(59, 130, 246, 0.35);
    background: rgba(37, 99, 235, 0.14);
  }
  .taf-metrics.is-destaque .taf-metric.is-win {
    border-color: rgba(34, 197, 94, 0.55);
    background: rgba(34, 197, 94, 0.16);
  }
  .taf-metrics.is-total .taf-metric {
    padding: 0.35rem 0.45rem;
  }
  .taf-metrics.is-total .taf-metric-val {
    font-size: 0.92rem;
    color: #cbd5e1;
  }
  .taf-janela-input {
    width: 72px;
    background: #0f172a !important;
    color: #e2e8f0 !important;
    border-color: rgba(148, 163, 184, 0.25) !important;
    text-align: center;
  }

  .taf-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
  }
  .taf-badge-campeao {
    background: rgba(34, 197, 94, 0.22);
    color: #86efac;
    border: 1px solid rgba(74, 222, 128, 0.35);
  }
  .taf-badge-empate {
    background: rgba(251, 191, 36, 0.18);
    color: #fde68a;
    border: 1px solid rgba(251, 191, 36, 0.35);
  }
  .taf-badge-neutro {
    background: rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .taf-ref-mini {
    font-size: 0.72rem;
    color: #64748b;
    border-top: 1px dashed rgba(148, 163, 184, 0.18);
    padding-top: 0.45rem;
  }

  .taf-log-local {
    max-height: 220px;
    overflow: auto;
    border-top: 1px dashed rgba(148, 163, 184, 0.18);
    padding-top: 0.45rem;
  }
  .taf-log-local-title {
    font-size: 0.68rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
  }
  .taf-log-row {
    display: grid;
    grid-template-columns: 58px 1fr 52px;
    gap: 0.35rem;
    font-size: 0.75rem;
    padding: 0.28rem 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }
  .taf-log-row:last-child { border-bottom: 0; }
  .taf-log-time { color: #64748b; font-variant-numeric: tabular-nums; }

  .taf-section-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
  }
  .taf-section-sub {
    font-size: 0.78rem;
    color: #94a3b8;
    margin: 0.15rem 0 0;
  }
  .taf-table {
    --bs-table-bg: transparent;
    --bs-table-color: #e2e8f0;
    --bs-table-border-color: rgba(148, 163, 184, 0.14);
    --bs-table-hover-bg: rgba(51, 65, 85, 0.35);
    font-size: 0.8rem;
  }
  .taf-table thead th {
    color: #94a3b8;
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .taf-empty {
    color: #64748b;
    text-align: center;
    padding: 1.5rem 1rem;
    font-size: 0.88rem;
  }
  .taf-nav-pills .nav-link {
    color: #94a3b8;
    border: 1px solid transparent;
    font-size: 0.82rem;
  }
  .taf-nav-pills .nav-link.active {
    background: rgba(37, 99, 235, 0.25);
    color: #bfdbfe;
    border-color: rgba(59, 130, 246, 0.35);
  }

  .taf-modal .modal-content {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid rgba(148, 163, 184, 0.2);
  }
  .taf-modal .modal-header,
  .taf-modal .modal-footer { border-color: rgba(148, 163, 184, 0.18); }
  .taf-gw-option {
    background: rgba(15, 23, 42, 0.55);
    color: #e2e8f0;
    border-color: rgba(148, 163, 184, 0.15);
    cursor: pointer;
  }
  .taf-gw-option:hover {
    background: rgba(37, 99, 235, 0.18);
    color: #e2e8f0;
  }
</style>

<div ng-controller="trackingAferidorCtrl" class="app-container" ng-cloak>

  <div class="app-hero-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
      <div class="taf-breadcrumb">
        <i class="bi bi-house me-1"></i>
        <a>Administração</a>
        <span class="mx-1">›</span>
        <span>Aferidor de Gateways</span>
      </div>
      <h1 class="taf-title">Aferidor de Gateways</h1>
      <p class="taf-subtitle">
        Análise em tempo real por média de RSSI, melhor RSSI e quantidade de leituras — sem regras de tracking.
      </p>
    </div>
    <div class="text-end">
      <div class="taf-datetime">{{ _dataHoraTopo }}</div>
      <div class="taf-live mt-1"
           ng-class="{
             'is-paused': _disputaStatus === 'paused',
             'is-idle': _disputaStatus === 'idle' || _disputaStatus === 'ended'
           }">
        <span class="taf-live-dot"></span>
        {{ statusDisputaLabel() }}
      </div>
    </div>
  </div>

  <div class="app-body taf-page">

    <div class="card taf-panel mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
          <div style="flex: 1 1 320px; min-width: 0;">
            <div class="taf-gw-label">Gateways em aferição</div>
            <div class="taf-gw-chips">
              <button type="button" class="taf-gw-add" title="Vincular gateway"
                      ng-click="onAbrirModalGateways()"
                      ng-disabled="_disputaStatus === 'running' || _disputaStatus === 'paused'">
                <i class="bi bi-plus-lg"></i>
              </button>
              <button type="button" class="taf-gw-chip"
                      ng-repeat="g in _gatewaysSelecionados track by g._id"
                      title="Remover {{ g.descricao || g.tokem }}"
                      ng-click="onRemoverGateway(g)">
                <span class="text-truncate">{{ g.descricao || g.tokem }}</span>
                <i class="bi bi-x"></i>
              </button>
              <span class="taf-gw-hint" ng-if="!_gatewaysSelecionados.length">
                Nenhum vinculado — clique em + para selecionar
              </span>
            </div>
          </div>

          <div class="d-flex flex-wrap align-items-end gap-2">
            <button type="button" class="taf-btn taf-btn-start"
                    ng-click="onIniciarDisputa()"
                    ng-disabled="!podeIniciar()">
              <i class="bi bi-play-fill me-1"></i>Iniciar disputa
            </button>
            <button type="button" class="taf-btn taf-btn-pause"
                    ng-click="onPausarDisputa()"
                    ng-disabled="!podePausar() && !podeRetomar()">
              <i class="bi" ng-class="podeRetomar() ? 'bi-play-fill' : 'bi-pause-fill'"></i>
              {{ podeRetomar() ? 'Retomar' : 'Pausar' }}
            </button>
            <button type="button" class="taf-btn taf-btn-stop"
                    ng-click="onEncerrarDisputa()"
                    ng-disabled="!podeEncerrar()">
              <i class="bi bi-stop-fill me-1"></i>Encerrar
            </button>
            <button type="button" class="taf-btn taf-btn-ghost" ng-click="onLimpar()">
              <i class="bi bi-trash3 me-1"></i>Limpar
            </button>
            <div>
              <label class="form-label small text-secondary mb-1 d-block">Janela (s)</label>
              <input type="number" min="1" max="3600" step="1"
                     class="form-control form-control-sm taf-janela-input"
                     ng-model="_janelaChecagemSeg"
                     ng-change="onJanelaChange()"
                     ng-disabled="_disputaStatus === 'running'"
                     title="A cada N segundos as métricas da janela são checadas e o campeão é alocado">
            </div>
            <div class="small text-secondary pb-1" ng-if="_disputaStatus === 'running' || _disputaStatus === 'paused'">
              Próxima checagem:
              <strong class="text-info">
                {{ _segundosRestantes != null ? (_segundosRestantes + 's') : '—' }}
              </strong>
            </div>
          </div>
        </div>

        <div class="taf-ref-banner mt-3" ng-if="_disputaReferencia">
          <strong>Referência (última disputa):</strong>
          {{ fmtDataHora(_disputaReferencia.inicio) }} → {{ fmtDataHora(_disputaReferencia.fim) }}
          · {{ _disputaReferencia.total_leituras || 0 }} leituras
          ·
          <span ng-repeat="t in _disputaReferencia.tags track by t.tag">
            {{ t.tag }} → <strong>{{ t.vencedor_nome || '—' }}</strong><span ng-if="!$last">; </span>
          </span>
          <span ng-if="!_disputaReferencia.tags.length">sem tags</span>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <!-- Cards -->
      <div class="col-xl-7 col-lg-6">
        <div class="taf-cards-board" ng-if="_cardsGateway.length">
          <div class="taf-card"
               ng-repeat="card in _cardsGateway track by card.gateway._id"
               ng-class="{
                 'is-dragging': card._dragging,
                 'is-drag-over': card._dragOver,
                 'is-winner': card.ehVencedor
               }"
               taf-draggable
               taf-drag-start="onCardDragStart($event, card)"
               taf-drag-end="onCardDragEnd(card)"
               taf-drag-over="onCardDragOver($event, card)"
               taf-drop="onCardDrop($event, card)">

            <div class="taf-card-head">
              <div class="min-w-0">
                <h3 class="taf-card-title text-truncate">{{ card.gateway.descricao }}</h3>
                <div class="small text-secondary mt-1">
                  <span class="taf-badge taf-badge-campeao" ng-if="card.ehVencedor && card.tagAtiva">
                    <i class="bi bi-trophy"></i> Ganhador
                  </span>
                  <span class="taf-badge taf-badge-empate" ng-if="card.empate && card.tagAtiva && !card.ehVencedor">
                    Empate
                  </span>
                  <span class="taf-badge taf-badge-neutro" ng-if="card.tagAtiva && !card.ehVencedor && !card.empate">
                    {{ card.pontos.total }}/3 critérios
                  </span>
                  <span class="text-secondary" ng-if="!card.tagAtiva">Aguardando tags…</span>
                </div>
              </div>
              <div class="taf-drag-handle" title="Arrastar"><i class="bi bi-grip-vertical"></i></div>
            </div>

            <div class="taf-card-body">
              <div class="taf-tag-tabs" ng-if="card.tags.length">
                <button type="button" class="taf-tag-tab"
                        ng-repeat="tag in card.tags track by tag"
                        ng-class="{active: card.tagAtiva === tag}"
                        ng-click="onSelecionarTag(card.gateway._id, tag)">
                  {{ tag }}
                </button>
              </div>
              <div class="taf-empty py-2" ng-if="!card.tags.length">
                {{ _disputaStatus === 'running' ? 'Aguardando leituras…' : 'Inicie a disputa para coletar tags.' }}
              </div>

              <div ng-if="card.tagAtiva">
                <div class="taf-metrics-block-title">
                  <span>Janela atual</span>
                  <span class="taf-countdown" ng-if="_segundosRestantes != null && (_disputaStatus === 'running' || _disputaStatus === 'paused')">
                    {{ _segundosRestantes }}s
                  </span>
                </div>
                <div class="taf-metrics is-destaque mb-2">
                  <div class="taf-metric" ng-class="{'is-win': card.pontos.qtd}">
                    <div class="taf-metric-lbl">Leituras</div>
                    <div class="taf-metric-val">{{ card.metricasJanela.qtd }}</div>
                  </div>
                  <div class="taf-metric" ng-class="{'is-win': card.pontos.media}">
                    <div class="taf-metric-lbl">Média RSSI</div>
                    <div class="taf-metric-val">{{ fmtRssi(card.metricasJanela.media) }}</div>
                  </div>
                  <div class="taf-metric" ng-class="{'is-win': card.pontos.melhor}">
                    <div class="taf-metric-lbl">Melhor RSSI</div>
                    <div class="taf-metric-val">{{ card.metricasJanela.melhor != null ? card.metricasJanela.melhor : '—' }}</div>
                  </div>
                </div>

                <div class="taf-metrics-block-title">
                  <span>Toda a disputa</span>
                </div>
                <div class="taf-metrics is-total mb-2">
                  <div class="taf-metric">
                    <div class="taf-metric-lbl">Leituras</div>
                    <div class="taf-metric-val">{{ card.metricasTotal.qtd }}</div>
                  </div>
                  <div class="taf-metric">
                    <div class="taf-metric-lbl">Média RSSI</div>
                    <div class="taf-metric-val">{{ fmtRssi(card.metricasTotal.media) }}</div>
                  </div>
                  <div class="taf-metric">
                    <div class="taf-metric-lbl">Melhor RSSI</div>
                    <div class="taf-metric-val">{{ card.metricasTotal.melhor != null ? card.metricasTotal.melhor : '—' }}</div>
                  </div>
                </div>

                <div class="small text-secondary mb-2">
                  Campeão (última checagem):
                  <strong class="text-light">{{ card.vencedorNome }}</strong>
                  <span ng-if="card.campeaoQuando"> · {{ fmtHora(card.campeaoQuando) }}</span>
                </div>

                <div class="taf-ref-mini" ng-if="card.referencia || card.referenciaVencedor">
                  <span ng-if="card.referencia">
                    Ref. anterior neste GW:
                    {{ card.referencia.qtd }} leit. ·
                    média {{ fmtRssi(card.referencia.media) }} ·
                    melhor {{ card.referencia.melhor != null ? card.referencia.melhor : '—' }}
                    <span ng-if="card.referencia.vencedor"> · era ganhador</span>
                  </span>
                  <span ng-if="!card.referencia && card.referenciaVencedor">
                    Ref. anterior: ganhador {{ card.referenciaVencedor }}
                  </span>
                </div>

                <div class="taf-log-local">
                  <div class="taf-log-local-title">
                    Leituras · {{ card.tagAtiva }} × {{ card.gateway.descricao }}
                  </div>
                  <div ng-if="!card.leiturasTag.length" class="small text-secondary">Sem leituras nesta tag.</div>
                  <div class="taf-log-row" ng-repeat="l in card.leiturasTag track by l._id_local">
                    <div class="taf-log-time">{{ fmtHora(l.data_leitura) }}</div>
                    <div class="text-truncate">{{ l.tag }}</div>
                    <div class="text-end">{{ l.rssi != null ? l.rssi : '—' }}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card taf-panel" ng-if="!_cardsGateway.length">
          <div class="card-body taf-empty">
            Vincule gateways pelo botão <strong>+</strong> e inicie a disputa.
          </div>
        </div>
      </div>

      <!-- Log direita -->
      <div class="col-xl-5 col-lg-6">
        <div class="card taf-panel h-100">
          <div class="card-body">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
              <div>
                <h2 class="taf-section-title">Log de leituras</h2>
                <p class="taf-section-sub">Registro incondicional tag × gateway desde o início da disputa</p>
              </div>
              <span class="badge text-bg-primary">{{ leiturasFiltradas().length }}</span>
            </div>

            <ul class="nav nav-pills taf-nav-pills mb-3 gap-1">
              <li class="nav-item">
                <button type="button" class="nav-link rounded-pill"
                        ng-class="{active: _abaDireita === 'leituras'}"
                        ng-click="_abaDireita = 'leituras'">
                  Todas as leituras
                </button>
              </li>
              <li class="nav-item">
                <button type="button" class="nav-link rounded-pill"
                        ng-class="{active: _abaDireita === 'resumo'}"
                        ng-click="_abaDireita = 'resumo'">
                  Resumo por tag e gateway
                </button>
              </li>
            </ul>

            <div class="row g-2 mb-3">
              <div class="col-md-5">
                <label class="form-label small text-secondary mb-1">Gateway</label>
                <select class="form-select form-select-sm taf-select" ng-model="_filtroGateway">
                  <option value="">Todos</option>
                  <option ng-repeat="g in _gatewaysSelecionados track by g._id" value="{{ g._id }}">
                    {{ g.descricao }}
                  </option>
                </select>
              </div>
              <div class="col-md-7">
                <label class="form-label small text-secondary mb-1">Tag</label>
                <input type="text" class="form-control form-control-sm taf-input"
                       ng-model="_filtroTag" placeholder="Filtrar tag">
              </div>
            </div>

            <div ng-show="_abaDireita === 'leituras'">
              <div class="table-responsive" style="max-height:62vh; overflow:auto;">
                <table class="table taf-table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Hora</th>
                      <th>Tag</th>
                      <th>Gateway</th>
                      <th>RSSI</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr ng-repeat="l in leiturasFiltradas() track by l._id_local">
                      <td>{{ fmtHora(l.data_leitura) }}</td>
                      <td>{{ l.tag }}</td>
                      <td>{{ l.gateway_descricao }}</td>
                      <td>{{ l.rssi != null ? l.rssi : '—' }}</td>
                    </tr>
                    <tr ng-if="!leiturasFiltradas().length">
                      <td colspan="4" class="taf-empty">
                        {{ _disputaStatus === 'idle' ? 'Inicie a disputa para registrar leituras.' : 'Aguardando leituras…' }}
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div ng-show="_abaDireita === 'resumo'">
              <div class="table-responsive" style="max-height:62vh; overflow:auto;">
                <table class="table taf-table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Tag</th>
                      <th>Gateway</th>
                      <th>Qtd</th>
                      <th>Média</th>
                      <th>Melhor</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr ng-repeat="r in resumoPorTagGateway() track by (r.tag + '-' + r.id_gateway)">
                      <td>{{ r.tag }}</td>
                      <td>{{ r.gateway_descricao }}</td>
                      <td>{{ r.qtd }}</td>
                      <td>{{ fmtRssi(r.media) }}</td>
                      <td>{{ r.melhor != null ? r.melhor : '—' }}</td>
                    </tr>
                    <tr ng-if="!resumoPorTagGateway().length">
                      <td colspan="5" class="taf-empty">Sem dados ainda.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal vincular -->
    <div class="modal fade taf-modal" id="modalAferidorGateways" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">
              <i class="bi bi-broadcast-pin me-2"></i>Vincular gateway
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p class="text-secondary small mb-3">
              Selecione os coletores para a aferição. A escolha fica salva neste navegador.
            </p>
            <input type="text" class="form-control form-control-sm taf-input mb-3"
                   ng-model="_pesquisaModalGw" ng-change="onFiltraModalGateways()"
                   placeholder="Pesquisar descrição ou tokem">

            <div ng-show="_carregandoGateways" class="text-secondary small">
              <span class="spinner-border spinner-border-sm me-1"></span>Carregando…
            </div>
            <div ng-show="!_carregandoGateways && !_listGatewaysDisponiveis.length" class="text-secondary small">
              Nenhum gateway disponível.
            </div>
            <div class="list-group" ng-show="!_carregandoGateways && _listGatewaysDisponiveis.length">
              <button type="button"
                      class="list-group-item list-group-item-action d-flex align-items-center gap-3 taf-gw-option"
                      ng-repeat="g in _listGatewaysDisponiveis track by g._id"
                      ng-click="onAdicionarGateway(g)">
                <i class="bi bi-plus-circle text-primary flex-shrink-0"></i>
                <div class="flex-grow-1 min-w-0 text-start">
                  <div class="fw-semibold">{{ g.descricao || 'Sem descrição' }}</div>
                  <small class="text-secondary">
                    {{ g.tokem || 'Sem token' }}
                    <span ng-show="g.modo"> · {{ g.modo == 'fixo' ? 'Fixo' : (g.modo == 'fluxo' ? 'Fluxo' : 'Móvel') }}</span>
                  </small>
                </div>
              </button>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
