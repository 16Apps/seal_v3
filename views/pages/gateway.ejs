<%- contentFor('body') %>
  <div ng-controller="gatewayCtrl" class="app-container" ng-cloak>

    <!-- App hero header starts -->
    <div class="app-hero-header d-flex align-items-center">

      <!-- Breadcrumb start -->
      <ol class="breadcrumb d-none d-lg-flex">
        <li class="breadcrumb-item">
          <i class="bi bi-house lh-1"></i>
          <a class="text-decoration-none">Extras</a>
        </li>
        <li class="breadcrumb-item" aria-current="page">{{ _regConta.params_nomenclatura_itens.coletores }}s</li>
      </ol>
      <!-- Breadcrumb end -->

      <!-- Filter start -->
      <div class="ms-auto d-flex flex-row gap-1 align-items-center">
        <div class="search-container d-lg-flex d-none">
          <input ng-model="_pesquisa" type="text" class="form-control" id="searchData"
            placeholder="Pesquisar tokem ou descrição">
          <i class="bi bi-search"></i>
        </div>
        <button ng-click="onCarregaRegistros()" type="button"
          class="btn btn-secondary btn-sm" title="Atualizar dados">
          <i class="bi bi-arrow-clockwise"></i>
        </button>
        <button ng-click="onGateway('add', undefined)" type="button"
          class="btn btn-warning btn-sm text-dark">Novo</button>
      </div>
      <!-- Filter end -->

    </div>
    <!-- App Hero header ends -->

    <!-- App body starts -->
    <div class="app-body">

      <div class="modal fade" id="modalGateway" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
          <gateway funcao="funcaoLoc" edit="editLoc" on-fechar="onGateway()"></gateway>
        </div>
      </div>


      <div class="row gx-3">
        <div class="col-xxl-12">
          <div class="card mb-3">
            <div class="card-body">
              <div class="table-responsive">
                <div class="table-outer">
                  <table class="table align-middle table-hover m-0">
                    <thead>
                      <tr>

                        <!-- Descrição -->
                        <th>

                        </th>

                        <th class="w-30" class="sortable" ng-click="sortBy('descricao')">Descrição
                          <i class="bi" ng-class="{
            'bi-caret-up-fill': sortField=='descricao' && !sortReverse,
            'bi-caret-down-fill': sortField=='descricao' && sortReverse
         }"></i>
                        </th>

                        <!-- Modo -->
                        <th class="w-60 sortable" ng-click="sortBy('modo')">
                          Modo
                          <i class="bi" ng-class="{
            'bi-caret-up-fill': sortField=='modo' && !sortReverse,
            'bi-caret-down-fill': sortField=='modo' && sortReverse
         }"></i>
                        </th>

                        <!-- Tokem -->
                        <th class="w-10 sortable" ng-click="sortBy('tokem')">
                          Tokem
                          <i class="bi" ng-class="{
            'bi-caret-up-fill': sortField=='tokem' && !sortReverse,
            'bi-caret-down-fill': sortField=='tokem' && sortReverse
         }"></i>
                        </th>

                         <!-- Sinal -->
                         <th class="w-10 sortable" ng-click="sortBy('_ultimoSinal.valor')">
                          Sinal
                          <i class="bi" ng-class="{
            'bi-caret-up-fill': sortField=='_ultimoSinal.valor' && !sortReverse,
            'bi-caret-down-fill': sortField=='_ultimoSinal.valor' && sortReverse
         }"></i>
                        </th>

                        <th>Ações</th>

                      </tr>
                    </thead>

                    <tbody>
                      <tr ng-repeat="item in _listGateways | filter:filtraGateway | orderBy:sortField:sortReverse">
                        <td>
                          <img class="rounded-circle img-3x me-2" src="{{ item._foto }}" alt="Wrapmarket" />
                        </td>
                        <td>{{ item.descricao }}</td>
                        <td>
                          {{ item.modo == 'fixo' ? 'Fixo' : (item.modo == 'fluxo' ? 'Fluxo' : 'Móvel') }}
                          <div ng-if="item.modo == 'fixo' && item._niveisTexto" class="small text-muted mt-1">
                            {{ item._niveisTexto }}
                          </div>
                        </td>
                        <td>
                          {{ item.tokem }}
                          <br>
                          <small class="text-muted">{{ item.tokem_associado }}</small>
                        </td>

                        <td>
                          <span ng-if="item._ultimoSinal"
                            ng-class="{
                              'text-success': +item._ultimoSinal.valor >= 70,
                              'text-warning': +item._ultimoSinal.valor >= 30 && +item._ultimoSinal.valor < 70,
                              'text-danger': +item._ultimoSinal.valor < 30
                            }">
                            {{ item._ultimoSinal.data }}
                            <span>·</span>
                            {{ item._ultimoSinal.valor }}%
                          </span>
                          <span ng-if="!item._ultimoSinal" class="text-muted">—</span>
                        </td>
                        <td>
                          <a class="btn btn-info btn-sm" ng-click="onGateway('edit', item)">
                            <i class="bi bi-pencil"></i>
                          </a>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
    <!-- App body ends -->