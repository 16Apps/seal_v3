                                        </option>
                                      </select>
                                    </fieldset>
                                  </div>
                                  <div class="col-lg-4">
                                  </div>
                                </div>
                                <div class="row mt-4">
                                  <div class="col-lg-4">
                                    <fieldset>
                                      <input ng-model="_editSolucao.titulo" type="text" placeholder="TÍTULO..."
                                        required="">
                                    </fieldset>
                                  </div>
                                  <div class="col-lg-8">
                                    <fieldset>
                                      <textarea ng-model="_editSolucao.descricao" type="text" class="form-control"
                                        placeholder="DESCRIÇÃO..." required=""></textarea>
                                    </fieldset>
                                  </div>
                                </div>

                                <div class="row mt-4">
                                  <div class="col-lg-12">
                                    <fieldset>
                                      <input ng-model="_editSolucao.link" type="text" placeholder="LINK DA SOLUÇÃO..."
                                        required="">
                                    </fieldset>
                                  </div>
                                </div>

                                <div class="row mt-4">
                                  <div class="col-lg-12">
                                    <fieldset>
                                      <input ng-model="_editSolucao.link_apresentacao" type="text"
                                        placeholder="LINK APRESENTAÇÃO..." required="">
                                    </fieldset>
                                  </div>
                                </div>

                              </div>
                            </div>



                            <div class="col-lg-12 mt-4" style="text-align: right;">
                              <fieldset>
                                <button ng-click="onSalvarSolucao()" id="form-submit" class="button">SALVAR</button>
                              </fieldset>
                            </div>

                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </section>
          </div>
        </div>
      </div>
    </div>

  </div>


  <!-- Scripts -->
