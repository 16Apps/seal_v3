    <!-- ***** Main Banner Area Start ***** -->
    <section class="section main-banner" id="top" data-section="section1">
      <video autoplay muted loop id="bg-video">
        <source src="showroom/assets/images/course-video.mp4" type="video/mp4" />
      </video>

      <div class="video-overlay header-text">
        <div class="container">
          <div class="row">
            <div class="col-lg-12">
              <div class="caption">
                <h6>INOVAÇÃO, TECNOLOGIA E PERFORMANCE EM TEMPO REAL</h6>
                <h2>Bem-vindo à nossa operação</h2>
                <p>
                  Aqui você acompanha como <a rel="nofollow">nossas soluções</a> conectam máquinas, pessoas e processos
                  para
                  entregar mais controle, eficiência e rastreabilidade.
                  Explore na tela os módulos, visualize os fluxos e descubra como a <a rel="nofollow">tecnologia
